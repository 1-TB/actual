    T.Check{"html2Plain \"Hello, world!\"", O.Ofx.html_to_plain("Hello, world!"), "Hello, world!"},
    T.Check{"html2Plain \"Hello, <b>world</b>!\"", O.Ofx.html_to_plain("Hello, <b>world</b>!"), "Hello, <b>world</b>!"},
    T.Check{"html2Plain \"Hello, &lt;world&gt;!\"", O.Ofx.html_to_plain("Hello, &lt;world&gt;!"), "Hello, <world>!"},
    T.Check{"html2Plain \"Hello, &#39;world&#39;!\"", O.Ofx.html_to_plain("Hello, &#39;world&#39;!"), "Hello, 'world'!"},
    T.Check{"html2Plain \"Hello, &quot;world&quot;!\"", O.Ofx.html_to_plain("Hello, &quot;world&quot;!"), "Hello, \"world\"!"},
    T.Check{"html2Plain \"Hello, &amp;world&amp;!\"", O.Ofx.html_to_plain("Hello, &amp;world&amp;!"), "Hello, &world&!"},
    T.Check{"html2Plain \"Hello, &#038;world&#038;!\"", O.Ofx.html_to_plain("Hello, &#038;world&#038;!"), "Hello, &world&!"},
    T.Check{"html2Plain \"Hello, &amp;#038;world&amp;#038;!\"", O.Ofx.html_to_plain("Hello, &amp;#038;world&amp;#038;!"), "Hello, &#038;world&#038;!"},
    T.Check{"html2Plain \"Hello, &#038;amp;world&#038;amp;!\"", O.Ofx.html_to_plain("Hello, &#038;amp;world&#038;amp;!"), "Hello, &amp;world&amp;!"},
    T.Check{"html2Plain \"Hello, &amp;quot;world&amp;quot;!\"", O.Ofx.html_to_plain("Hello, &amp;quot;world&amp;quot;!"), "Hello, &quot;world&quot;!"},
    T.Check{"html2Plain \"\"", O.Ofx.html_to_plain(""), ""},
    T.Check{"html2Plain \"&\"", O.Ofx.html_to_plain("&"), "&"},
    T.Check{"html2Plain \"&amp\"", O.Ofx.html_to_plain("&amp"), "&amp"},
    T.Check{"html2Plain \"&amp;amp;amp;\"", O.Ofx.html_to_plain("&amp;amp;amp;"), "&amp;amp;"},
    T.Check{"html2Plain \"&lt;&amp;lt;&#038;gt;&gt;\"", O.Ofx.html_to_plain("&lt;&amp;lt;&#038;gt;&gt;"), "<&lt;&gt;>"},
    T.Check{"html2Plain \"&&amp;&\"", O.Ofx.html_to_plain("&&amp;&"), "&&&"},
    T.Check{"html2Plain \"&#38;&#0038;&#39&quot\"", O.Ofx.html_to_plain("&#38;&#0038;&#39&quot"), "&#38;&#0038;&#39&quot"}
