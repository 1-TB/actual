import ../json/json.bend as J
import ./js.bend as X
import ./ofx.bend as O

def val(m: Maybe<&2, J.Json>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{j}:
      j

def str(m: Maybe<&2, String>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{s}:
      J.JStr{s}

def header(e: X.Js.Entry<Maybe<&2, String>>) -> J.Json.Member:
  match e:
    case X.Entry{k, v}:
      J.Member{k, str(v)}

def txn(t: O.Ofx.Txn) -> J.Json:
  match t:
    case O.Txn{amount, kind, fit_id, date, name, memo}:
      J.Json.object([J.Member{"amount", val(amount)}, J.Member{"type", val(kind)}, J.Member{"fitId", val(fit_id)},
        J.Member{"date", J.JStr{date}}, J.Member{"name", str(name)}, J.Member{"memo", str(memo)}])

def show(r: Result<&2, &2, String, O.Ofx.Data>) -> String:
  match r:
    case Fail{e}:
      "ERR " ++ e
    case Done{O.Parsed{headers, txns}}:
      J.Json.show(J.Json.object([
        J.Member{"headers", J.Json.object(X.Js.map(~X.Js.Entry<Maybe<&2, String>>, ~J.Json.Member, ~header, headers))},
        J.Member{"transactions", J.Json.array(X.Js.map(~O.Ofx.Txn, ~J.Json, ~txn, txns))}]))

def ofx(text: String) -> String:
  show(O.Ofx.parse(text))

