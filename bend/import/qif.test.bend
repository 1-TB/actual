def str(m: Maybe<&2, String>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{s}:
      J.JStr{s}

def num(m: Maybe<&2, N.Num>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{n}:
      J.JDec{N.Num.show(n)}

def strs(m: Maybe<&2, List<&2, String>>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{xs}:
      J.Json.array(X.Js.map(~String, ~J.Json, ~(s => J.JStr{s}), xs))

def division(d: Q.Qif.Division) -> J.Json:
  match d:
    case Q.Division{cat, sub, desc, amt}:
      J.Json.object([J.Member{"category", str(cat)}, J.Member{"subcategory", str(sub)},
        J.Member{"description", str(desc)}, J.Member{"amount", num(amt)}])

def divisions(m: Maybe<&2, List<&2, Q.Qif.Division>>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{xs}:
      J.Json.array(X.Js.map(~Q.Qif.Division, ~J.Json, ~division, xs))

def txn(t: Q.Qif.Txn) -> J.Json:
  match t:
    case Q.Txn{d, a, n, m, ad, c, cat, sub, p, div}:
      J.Json.object([J.Member{"date", str(d)}, J.Member{"amount", str(a)}, J.Member{"number", str(n)},
        J.Member{"memo", str(m)}, J.Member{"address", strs(ad)}, J.Member{"clearedStatus", str(c)},
        J.Member{"category", str(cat)}, J.Member{"subcategory", str(sub)}, J.Member{"payee", str(p)},
        J.Member{"division", divisions(div)}])

def show(r: Result<&2, &2, String, Q.Qif.Data>) -> String:
  match r:
    case Fail{e}:
      "ERR " ++ e
    case Done{Q.Parsed{df, kind, txns}}:
      J.Json.show(J.Json.object([J.Member{"dateFormat", str(df)}, J.Member{"type", J.JStr{kind}},
        J.Member{"transactions", J.Json.array(X.Js.map(~Q.Qif.Txn, ~J.Json, ~txn, txns))}]))

