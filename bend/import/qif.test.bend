    T.Check{"no trailing caret", show(Q.Qif.parse("!Type:Bank\nD1/1/20\nT1\n^\nD2/2/20\nT2", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"1/1/20\",\"amount\":\"1\",\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null},{\"date\":\"2/2/20\",\"amount\":\"2\",\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null}]}"},
    T.Check{"empty transactions", show(Q.Qif.parse("!Type:Bank\n^\n^\n", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null},{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null}]}"},
    T.Check{"all fields", show(Q.Qif.parse("!Type:Bank\nD3/4/21\nT1,234.56\nN1001\nMsome memo\nAline one\nAline two\nA\nPTom &amp; Jerry &amp;amp; co\nLFood:Dining:Out\nC*\n^\n", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"3/4/21\",\"amount\":\"1,234.56\",\"number\":\"1001\",\"memo\":\"some memo\",\"address\":[\"line one\",\"line two\",\"\"],\"clearedStatus\":\"*\",\"category\":\"Food\",\"subcategory\":\"Dining\",\"payee\":\"Tom & Jerry &amp; co\",\"division\":null}]}"},
    T.Check{"category without sub keeps the earlier one", show(Q.Qif.parse("!Type:Bank\nLA:B\nLC\n^\nLD\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":\"C\",\"subcategory\":\"B\",\"payee\":null,\"division\":null},{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":\"D\",\"subcategory\":null,\"payee\":null,\"division\":null}]}"},
    T.Check{"empty category", show(Q.Qif.parse("!Type:Bank\nL\n^\nL:x\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":\"\",\"subcategory\":null,\"payee\":null,\"division\":null},{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":\"\",\"subcategory\":\"x\",\"payee\":null,\"division\":null}]}"},
    T.Check{"splits", show(Q.Qif.parse("!Type:Bank\nD1/1/20\nT-100\nSFood:Groceries\nEweekly shop\n$-60.25\nSHome\n$-39.75\n^\nD1/2/20\nSRent\n$abc\n$ 12.5x\n$.5\n$-\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"1/1/20\",\"amount\":\"-100\",\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":[{\"category\":\"Food\",\"subcategory\":\"Groceries\",\"description\":\"weekly shop\",\"amount\":-60.25},{\"category\":\"Home\",\"subcategory\":null,\"description\":null,\"amount\":-39.75}]},{\"date\":\"1/2/20\",\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":[{\"category\":\"Rent\",\"subcategory\":null,\"description\":null,\"amount\":null},{\"category\":null,\"subcategory\":null,\"description\":null,\"amount\":12.5},{\"category\":null,\"subcategory\":null,\"description\":null,\"amount\":0.5},{\"category\":null,\"subcategory\":null,\"description\":null,\"amount\":null}]}]}"},
    T.Check{"division carries over a caret", show(Q.Qif.parse("!Type:Bank\nSCarry\nEdesc\n^\nD1/1/20\n$5\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":null,\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null},{\"date\":\"1/1/20\",\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":[{\"category\":\"Carry\",\"subcategory\":null,\"description\":\"desc\",\"amount\":5}]}]}"},
    T.Check{"division lines alone leave the transaction empty", show(Q.Qif.parse("!Type:Bank\nSOnly\nEdesc", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[]}"},
    T.Check{"unknown code", show(Q.Qif.parse("!Type:Bank\nD1/1/20\nXwhat\n^", None{})), "ERR Unknown Detail Code: X"},
    T.Check{"unknown code lowercase", show(Q.Qif.parse("!Type:Bank\nd1/1/20\n^", None{})), "ERR Unknown Detail Code: d"},
    T.Check{"blank line of spaces", show(Q.Qif.parse("!Type:Bank\nD1/1/20\n   \nT1\n^", None{})), "ERR Unknown Detail Code: undefined"},
    T.Check{"indented lines are trimmed", show(Q.Qif.parse("!Type:Bank\n  D1/1/20  \n\tT 5 \n ^ \n", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"1/1/20\",\"amount\":\" 5\",\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":null,\"division\":null}]}"},
    T.Check{"caret with text is a code", show(Q.Qif.parse("!Type:Bank\nD1/1/20\n^x\n", None{})), "ERR Unknown Detail Code: ^"},
    T.Check{"non-ASCII", show(Q.Qif.parse("!Type:Bank\nD1/1/20\nPCaf\u{e9} M\u{fc}nchen \u{20ac} \u{1f600}\nM\u{a0}padded\u{a0}\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"1/1/20\",\"amount\":null,\"number\":null,\"memo\":\"\u{a0}padded\",\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":\"Caf\u{e9} M\u{fc}nchen \u{20ac} \u{1f600}\",\"division\":null}]}"},
    T.Check{"codes with empty values", show(Q.Qif.parse("!Type:Bank\nD\nT\nN\nM\nP\nC\nA\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"\",\"amount\":\"\",\"number\":\"\",\"memo\":\"\",\"address\":[\"\"],\"clearedStatus\":\"\",\"category\":null,\"subcategory\":null,\"payee\":\"\",\"division\":null}]}"},
    T.Check{"repeated field overwrites", show(Q.Qif.parse("!Type:Bank\nD1/1/20\nD2/2/20\nPa\nPb\n^", None{})), "{\"dateFormat\":null,\"type\":\"Bank\",\"transactions\":[{\"date\":\"2/2/20\",\"amount\":null,\"number\":null,\"memo\":null,\"address\":null,\"clearedStatus\":null,\"category\":null,\"subcategory\":null,\"payee\":\"b\",\"division\":null}]}"}
  ])
