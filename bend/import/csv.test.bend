    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"\u{a0},b\"", show(C.Csv.parse("\"a\"\u{a0},b", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: found non trimable byte after quote at line 1"},
