    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\\\\\\\\\",c\"", show(C.Csv.parse("\"a\\\\\",c", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
