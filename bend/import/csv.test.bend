    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"\u{e9}\"", show(C.Csv.parse("\"a\"\u{e9}", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"\u{c3}\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\\"c\\\"d,e\"", show(C.Csv.parse("a,b\n\"c\"d,e", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"d\" at line 2 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
