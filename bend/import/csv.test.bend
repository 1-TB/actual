    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"\u{e9}\"", show(C.Csv.parse("\"a\"\u{e9}", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"\u{c3}\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
