    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",\\\"\\\"\"", show(C.Csv.parse("\"\",\"\"", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
