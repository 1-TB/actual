    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=null \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{False{}, True{}, ",", Some{Chr{34}}, None{}, True{}, True{}, True{}, True{}})), "[[\"multi\\nline\",\"x\"],[\"y\",\"z\\r\\nw\"]]"},
