    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\r\\n\"", show(C.Csv.parse("\r\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \",\"", show(C.Csv.parse(",", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"\",\"\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"0,1,00,01,1.5,-1,4294967294,4294967295\\na,b,c,d,e,f,g,h\"", show(C.Csv.parse("0,1,00,01,1.5,-1,4294967294,4294967295\na,b,c,d,e,f,g,h", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"0\",\"1\",\"00\",\"01\",\"1.5\",\"-1\",\"4294967294\",\"4294967295\"],[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a,b\\\",c\\n\\\"1\\n2\\\",3\"", show(C.Csv.parse("\"a,b\",c\n\"1\n2\",3", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a,b\",\"c\"],[\"1\\n2\",\"3\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\\"\\n\"", show(C.Csv.parse("a,b\n1,2\"\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 1 at line 2, value is \"2\""},
    T.Check{"random 0: HBL-X- d=\",\" q=\"\\\"\" e=null \"\u{e9}\\t\\n\u{e9}\\r\\n\u{feff} \u{e9}\u{e9}'\\\"\u{feff}a\"", show(C.Csv.parse("\u{e9}\t\n\u{e9}\r\n\u{feff} \u{e9}\u{e9}'\"\u{feff}a", C.Options{True{}, True{}, ",", Some{Chr{34}}, None{}, True{}, False{}, True{}, False{}})), "ERR Invalid Opening Quote: a quote is found on field \"\u{e9}\\t\" at line 4, value is \"\u{e9}\u{e9}'\""},
    T.Check{"random 1: -B--X- d=\";\" q=\"\\\"\" e=null \"\\\"\\\"\\t\\\\b\u{e9}'\\\\,\\\"\"", show(C.Csv.parse("\"\"\t\\b\u{e9}'\\,\"", C.Options{False{}, True{}, ";", Some{Chr{34}}, None{}, False{}, False{}, True{}, False{}})), "ERR Invalid Closing Quote: got \"\t\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
    T.Check{"random 2: -BLRX- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\r,\\\\\"", show(C.Csv.parse("\r,\\", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, False{}})), "[[\"\"],[\"\",\"\\\\\"]]"},
    T.Check{"random 3: ----X- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{a0}\\\"\\r,b ,\\\"\"", show(C.Csv.parse("\u{a0}\"\r,b ,\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, False{}, False{}, True{}, False{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"\u{a0}\""},
    T.Check{"random 4: HBLRX- d=\",,\" q=\"\\\"\" e=null \"b,\u{a0}\u{a0}\"", show(C.Csv.parse("b,\u{a0}\u{a0}", C.Options{True{}, True{}, ",,", Some{Chr{34}}, None{}, True{}, True{}, True{}, False{}})), "[]"},
    T.Check{"random 5: H--RXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{e9};\"", show(C.Csv.parse("\u{e9};", C.Options{True{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, False{}, True{}, True{}, True{}})), "[]"},
