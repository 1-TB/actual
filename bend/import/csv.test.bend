    T.Check{"-BLRXS d=\"||\" q=\"\\\"\" e=\"\\\"\" \"x,x,y\\n1,2,3\\n\"", show(C.Csv.parse("x,x,y\n1,2,3\n", C.Options{False{}, True{}, "||", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"x,x,y\"],[\"1,2,3\"]]"},
    T.Check{"-BLRXS d=\"||\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",h\\n1,2\"", show(C.Csv.parse("\"\",h\n1,2", C.Options{False{}, True{}, "||", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
