    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,'b,c'\\n\"", show(C.Csv.parse("a,'b,c'\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\",\"'b\",\"c'\"]]"},
    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,\\\"2\\n\"", show(C.Csv.parse("a,b\n1,\"2\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\\"\\n\"", show(C.Csv.parse("a,b\n1,2\"\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 1 at line 2, value is \"2\""},
    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\u{2028}b,c\u{2029}\\n\"", show(C.Csv.parse("a\u{2028}b,c\u{2029}\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\u{2028}b\",\"c\"]]"},
    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"Date,Payee,Amount\\n2025.12.04,Caf\u{e9} R\u{e9}my,100.25\\n2025.12.05,\\\"Boulangerie, M\u{fc}ller\\\",-42.10\\n\"", show(C.Csv.parse("Date,Payee,Amount\n2025.12.04,Caf\u{e9} R\u{e9}my,100.25\n2025.12.05,\"Boulangerie, M\u{fc}ller\",-42.10\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"Date\",\"Payee\",\"Amount\"],[\"2025.12.04\",\"Caf\u{e9} R\u{e9}my\",\"100.25\"],[\"2025.12.05\",\"Boulangerie, M\u{fc}ller\",\"-42.10\"]]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\"", show(C.Csv.parse("", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\"", show(C.Csv.parse("a", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\"", show(C.Csv.parse("a,b,c", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\n\"", show(C.Csv.parse("a,b,c\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\n1,2,3\\n\"", show(C.Csv.parse("a,b,c\n1,2,3\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\r\\n1,2,3\\r\\n\"", show(C.Csv.parse("a,b,c\r\n1,2,3\r\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\r1,2,3\\r\"", show(C.Csv.parse("a,b,c\r1,2,3\r", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\r\\n3,4\\r5,6\"", show(C.Csv.parse("a,b\n1,2\r\n3,4\r5,6", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"},{\"a\":\"3\",\"b\":\"4\\r5\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\r1,2\\n3,4\"", show(C.Csv.parse("a,b\r1,2\n3,4", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\\n3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\r\\n1,2\\n3,4\\r5\"", show(C.Csv.parse("a,b\r\n1,2\n3,4\r5", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\\n3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\n\\na,b\\n\\n\\n1,2\\n\\n\"", show(C.Csv.parse("\n\na,b\n\n\n1,2\n\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\r\\n\\r\\na,b\\r\\n\\r\\n\"", show(C.Csv.parse("\r\n\r\na,b\r\n\r\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \" a , b ,c \\n  1,2  , 3\"", show(C.Csv.parse(" a , b ,c \n  1,2  , 3", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\",\\\"b\\\",\\\"c\\\"\\n\\\"1\\\",\\\"2\\\",\\\"3\\\"\"", show(C.Csv.parse("\"a\",\"b\",\"c\"\n\"1\",\"2\",\"3\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a \\\"\\\"quoted\\\"\\\" b\\\",x\"", show(C.Csv.parse("\"a \"\"quoted\"\" b\",x", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"multi\\nline\":\"y\",\"x\":\"z\\r\\nw\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"  ,  \\\"b\\\"\\n\\\"c\\\" ,\\\"d\\\"  \"", show(C.Csv.parse("\"a\"  ,  \"b\"\n\"c\" ,\"d\"  ", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"c\",\"b\":\"d\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"  \\\"a\\\"  \\n\"", show(C.Csv.parse("  \"a\"  \n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"x\"", show(C.Csv.parse("\"a\"x", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"x\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\" x\"", show(C.Csv.parse("\"a\" x", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: found non trimable byte after quote at line 1"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\\\"b\"", show(C.Csv.parse("a\"b", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"a\""},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a \\\"b\\\"\"", show(C.Csv.parse("a \"b\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"a \""},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \" \\\"b\\\" c\"", show(C.Csv.parse(" \"b\" c", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: found non trimable byte after quote at line 1"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"unterminated\"", show(C.Csv.parse("\"unterminated", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 1"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\nb\"", show(C.Csv.parse("\"a\nb", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,\\\"b\\n\"", show(C.Csv.parse("a,\"b\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 1"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\"\"", show(C.Csv.parse("\"\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",\\\"\\\"\"", show(C.Csv.parse("\"\",\"\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
