    T.Check{"-BLRXS d=\"||\" q=\"\\\"\" e=\"\\\"\" \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{False{}, True{}, "||", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 2 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
