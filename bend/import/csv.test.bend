    T.Check{"random 7: HB-RX- d=\",,\" q=\"\\\"\" e=\"\\\"\" \",\u{e9}','\\n',\\t\u{e9}\\r\\n\\\\\"", show(C.Csv.parse(",\u{e9}','\n',\t\u{e9}\r\n\\", C.Options{True{}, True{}, ",,", Some{Chr{34}}, Some{Chr{34}}, False{}, True{}, True{}, False{}})), "[{\",\u{e9}','\":\"',\\t\u{e9}\"},{\",\u{e9}','\":\"\\\\\"}]"},
