# run over the CSV fixtures of packages/loot-core/src/mocks/files, over
# hand-made inputs and over random ones, under many option sets.
import Base
import ../lib/test.bend as T
import ../json/json.bend as J
import ./js.bend as X
import ./csv.bend as C

def member(e: X.Js.Entry<String>) -> J.Json.Member:
  match e:
    case X.Entry{k, v}:
      J.Member{k, J.JStr{v}}

def record(r: C.Csv.Record) -> J.Json:
  match r:
    case C.Row{fields}:
      J.Json.array(X.Js.map(~String, ~J.Json, ~(s => J.JStr{s}), fields))
    case C.Object{entries}:
      J.Json.object(X.Js.map(~X.Js.Entry<String>, ~J.Json.Member, ~member, entries))

def show(r: Result<&2, &2, String, List<&2, C.Csv.Record>>) -> String:
  match r:
    case Fail{e}:
      "ERR " ++ e
    case Done{records}:
      J.Json.show(J.Json.array(X.Js.map(~C.Csv.Record, ~J.Json, ~record, records)))

# The options of parse-file.ts.
def app(text: String, columns: Bool, delimiter: String) -> String:
  show(C.Csv.parse(text, C.Csv.options(columns, delimiter)))

