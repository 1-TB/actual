    T.Check{"random 20: HB-R-S d=\",\" q=\"'\" e=\"\\\"\" \"1b,\\t \\r\"", show(C.Csv.parse("1b,\t \r", C.Options{True{}, True{}, ",", Some{Chr{39}}, Some{Chr{34}}, False{}, True{}, False{}, True{}})), "[]"},
    T.Check{"random 21: -B--XS d=\";\" q=\"\\\"\" e=\"\\\\\" \"\\ta\\tb\\r\u{feff}\\\\ \\n\"", show(C.Csv.parse("\ta\tb\r\u{feff}\\ \n", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{92}}, False{}, False{}, True{}, True{}})), "[[\"\\ta\\tb\"],[\"\u{feff}\\\\ \\n\"]]"},
    T.Check{"random 22: HB-RXS d=\",\" q=\"\\\"\" e=\"\\\\\" \"\\\"\u{e9}\\t\\r\\t,,,\"", show(C.Csv.parse("\"\u{e9}\t\r\t,,,", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{92}}, False{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"random 23: HBL-XS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\r\\n\\r\\n\\n\u{a0}\u{feff}\u{e9}\"", show(C.Csv.parse("\"\r\n\r\n\n\u{a0}\u{feff}\u{e9}", C.Options{True{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, False{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 6"},
    T.Check{"random 24: H-L-XS d=\",\" q=\"\\\"\" e=\"\\\"\" \",;\\\\,,\\\\;\\\"\\n\u{a0}1\u{e9} \\n\"", show(C.Csv.parse(",;\\,,\\;\"\n\u{a0}1\u{e9} \n", C.Options{True{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, False{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 3 at line 1, value is \"\\\\;\""},
    T.Check{"random 25: -BLRXS d=\",\" q=\"\\\"\" e=\"\\\\\" \" \\rb\\t1\u{a0}\\\" \"", show(C.Csv.parse(" \rb\t1\u{a0}\" ", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{92}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 2, value is \"b\\t1\u{a0}\""},
    T.Check{"random 26: -BL-XS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\n\\\"\"", show(C.Csv.parse("\n\"", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, False{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"random 27: --LR-S d=\",\" q=\"\\\"\" e=null \"\\\"\u{e9} ab\\r,\\n\\\",\u{e9}\"", show(C.Csv.parse("\"\u{e9} ab\r,\n\",\u{e9}", C.Options{False{}, False{}, ",", Some{Chr{34}}, None{}, True{}, True{}, False{}, True{}})), "[[\"\u{e9} ab\\r,\\n\",\"\u{e9}\"]]"},
    T.Check{"random 28: -BLRX- d=\",\" q=\"'\" e=\"\\\"\" \"a\"", show(C.Csv.parse("a", C.Options{False{}, True{}, ",", Some{Chr{39}}, Some{Chr{34}}, True{}, True{}, True{}, False{}})), "[[\"a\"]]"},
    T.Check{"random 29: HBLRX- d=\";\" q=\"\\\"\" e=\"\\\"\" \"\\n,\\r\\n\"", show(C.Csv.parse("\n,\r\n", C.Options{True{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, False{}})), "[{\"\":\",\"}]"},
    T.Check{"random 30: -B-R-S d=\";\" q=\"\\\"\" e=\"\\\"\" \",\\\"\\n,\\\" a\\n\\t;\\\\\\\"\\\"\"", show(C.Csv.parse(",\"\n,\" a\n\t;\\\"\"", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, False{}, True{}, False{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \",\""},
    T.Check{"random 31: H-LR-- d=\",\" q=null e=null \"\\n \\\\\u{a0},\u{e9}b\\\\\u{e9}\u{e9}\\r\"", show(C.Csv.parse("\n \\\u{a0},\u{e9}b\\\u{e9}\u{e9}\r", C.Options{True{}, False{}, ",", None{}, None{}, True{}, True{}, False{}, False{}})), "ERR Invalid Record Length: columns length is 1, got 2 on line 2"},
    T.Check{"random 32: -BLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"'\u{feff}\\r\\r\\nb \\\\1,b\\r\\n,a\\n\"", show(C.Csv.parse("'\u{feff}\r\r\nb \\1,b\r\n,a\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"'\"],[\"b \\\\1\",\"b\"],[\"\",\"a\"]]"},
    T.Check{"random 33: ---R-S d=\",,\" q=\"\\\"\" e=null \"\u{a0}\\\"\\r\\n\\r\\n\\\\\"", show(C.Csv.parse("\u{a0}\"\r\n\r\n\\", C.Options{False{}, False{}, ",,", Some{Chr{34}}, None{}, False{}, True{}, False{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"\u{a0}\""},
    T.Check{"random 34: HBLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"'b\\t\\t ,,\\\"b\\n\\\"\u{a0}\"", show(C.Csv.parse("'b\t\t ,,\"b\n\"\u{a0}", C.Options{True{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"'b\\t\\t ,,\""},
    T.Check{"random 35: -B---- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\t\\r\\n\u{e9},\u{a0}\"", show(C.Csv.parse("\u{feff}\t\r\n\u{e9},\u{a0}", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, False{}, False{}, False{}, False{}})), "ERR Invalid Record Length: expect 1, got 2 on line 2"},
    T.Check{"random 36: -B-R-S d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\n\\\"\\t'\"", show(C.Csv.parse("\n\"\t'", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, False{}, True{}, False{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"random 37: -B--XS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\\r\\\"a\u{a0};\"", show(C.Csv.parse("\r\"a\u{a0};", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, False{}, False{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"random 38: H--RXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\\r\\na\\t\\\\\\n \\\",,\"", show(C.Csv.parse("\r\na\t\\\n \",,", C.Options{True{}, False{}, ";", Some{Chr{34}}, Some{Chr{34}}, False{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 3, value is \"a\\t\\\\\\n \""},
