    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"0,1,00,01,1.5,-1,4294967294,4294967295\\na,b,c,d,e,f,g,h\"", show(C.Csv.parse("0,1,00,01,1.5,-1,4294967294,4294967295\na,b,c,d,e,f,g,h", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"0,1,00,01,1.5,-1,4294967294,4294967295\":\"a,b,c,d,e,f,g,h\"}]"},
    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\\\"a,b\\\",c\\n\\\"1\\n2\\\",3\"", show(C.Csv.parse("\"a,b\",c\n\"1\n2\",3", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
