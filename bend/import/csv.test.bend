    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\" \\\"x\\\"\"", show(C.Csv.parse("\"\" \"x\"", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: found non trimable byte after quote at line 1"},
