    T.Check{"HBLR-- d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\n\\\"c\\n\\nd\\\",e\\n\"", show(C.Csv.parse("a,b\n\n\"c\n\nd\",e\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, False{}})), "ERR Invalid Record Length: columns length is 2, got 1 on line 2"},
