    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\n\\\"c\\n\\nd\\\",e\\n\"", show(C.Csv.parse("a,b\n\n\"c\n\nd\",e\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\",\"b\"],[\"c\\n\\nd\",\"e\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\\n\\\"b\\\"\\n\"", show(C.Csv.parse("a\n\"b\"\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\"],[\"b\"]]"},
