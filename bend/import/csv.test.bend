    T.Check{"random 15: -B-RXS d=\",\" q=\"\\\"\" e=\"\\\\\" \"\u{feff}\u{a0}\\\"b\"", show(C.Csv.parse("\u{feff}\u{a0}\"b", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{92}}, False{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"\u{a0}\""},
