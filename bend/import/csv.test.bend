    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\\\" \" a , b ,c \\n  1,2  , 3\"", show(C.Csv.parse(" a , b ,c \n  1,2  , 3", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{92}}, True{}, True{}, True{}, True{}})), "[[\"a\",\"b\",\"c\"],[\"1\",\"2\",\"3\"]]"},
    T.Check{"-BLRXS d=\",\" q=\"\\\"\" e=\"\\\\\" \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{92}}, True{}, True{}, True{}, True{}})), "[[\"multi\\nline\",\"x\"],[\"y\",\"z\\r\\nw\"]]"},
