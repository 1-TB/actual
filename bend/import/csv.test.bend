    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{e9}\\\"x\\\"\"", show(C.Csv.parse("\u{e9}\"x\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"\u{e9}\""},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\\"c\\\"d,e\"", show(C.Csv.parse("a,b\n\"c\"d,e", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"d\" at line 2 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
