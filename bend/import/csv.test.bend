    T.Check{"-BLRXS d=\"||\" q=\"\\\"\" e=\"\\\"\" \"0,1,00,01,1.5,-1,4294967294,4294967295\\na,b,c,d,e,f,g,h\"", show(C.Csv.parse("0,1,00,01,1.5,-1,4294967294,4294967295\na,b,c,d,e,f,g,h", C.Options{False{}, True{}, "||", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"0,1,00,01,1.5,-1,4294967294,4294967295\"],[\"a,b,c,d,e,f,g,h\"]]"},
