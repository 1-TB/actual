    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\\"a\\\",b\\n1,2\"", show(C.Csv.parse("\u{feff}\"a\",b\n1,2", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
