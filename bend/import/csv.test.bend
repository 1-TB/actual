    T.Check{"HBLR-- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\\"a\\\",b\\n1,2\"", show(C.Csv.parse("\u{feff}\"a\",b\n1,2", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, False{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLR-- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\n\"", show(C.Csv.parse("\u{feff}\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, False{}})), "[]"},
