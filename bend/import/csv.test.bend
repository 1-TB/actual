    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \" a , b ,c \\n  1,2  , 3\"", show(C.Csv.parse(" a , b ,c \n  1,2  , 3", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a , b ,c\":\"1,2  , 3\"}]"},
    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 2 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
