    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\n\\\"c\\n\\nd\\\",e\\n\"", show(C.Csv.parse("a,b\n\n\"c\n\nd\",e\n", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 5 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
