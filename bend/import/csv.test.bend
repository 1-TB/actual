    T.Check{"HBLR-- d=\",\" q=\"\\\"\" e=\"\\\"\" \"0,1,00,01,1.5,-1,4294967294,4294967295\\na,b,c,d,e,f,g,h\"", show(C.Csv.parse("0,1,00,01,1.5,-1,4294967294,4294967295\na,b,c,d,e,f,g,h", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, False{}})), "[{\"0\":\"a\",\"1\":\"b\",\"4294967294\":\"g\",\"00\":\"c\",\"01\":\"d\",\"1.5\":\"e\",\"-1\":\"f\",\"4294967295\":\"h\"}]"},
    T.Check{"HBLR-- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a,b\\\",c\\n\\\"1\\n2\\\",3\"", show(C.Csv.parse("\"a,b\",c\n\"1\n2\",3", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, False{}})), "[{\"a,b\":\"1\\n2\",\"c\":\"3\"}]"},
