    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"multi\\nline\\\",x\\ny,\\\"z\\r\\nw\\\"\"", show(C.Csv.parse("\"multi\nline\",x\ny,\"z\r\nw\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"multi\\nline\",\"x\"],[\"y\",\"z\\r\\nw\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"x\"", show(C.Csv.parse("\"a\"x", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"x\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a \\\"b\\\"\"", show(C.Csv.parse("a \"b\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"a \""},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\nb\"", show(C.Csv.parse("\"a\nb", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",\\\"\\\"\"", show(C.Csv.parse("\"\",\"\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"\",\"\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\" \\\"x\\\"\"", show(C.Csv.parse("\"\" \"x\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: found non trimable byte after quote at line 1"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\"\\\"\\\"\"", show(C.Csv.parse("\"\"\"\"", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"\\\"\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \",\\n,\\n\"", show(C.Csv.parse(",\n,\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"\",\"\"],[\"\",\"\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\\n   \\nb\"", show(C.Csv.parse("a\n   \nb", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\"],[\"b\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"x,x,y\\n1,2,3\\n\"", show(C.Csv.parse("x,x,y\n1,2,3\n", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"x\",\"x\",\"y\"],[\"1\",\"2\",\"3\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",h\\n1,2\"", show(C.Csv.parse("\"\",h\n1,2", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"\",\"h\"],[\"1\",\"2\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a||b||c\\n1||2|3||4\"", show(C.Csv.parse("a||b||c\n1||2|3||4", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a||b||c\"],[\"1||2|3||4\"]]"},
    T.Check{"--LRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\\"a\\\",b\\n1,2\"", show(C.Csv.parse("\u{feff}\"a\",b\n1,2", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a\",\"b\"],[\"1\",\"2\"]]"},
