    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\\\\\"b\\\",c\"", show(C.Csv.parse("\"a\\\"b\",c", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \"b\" at line 1 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\\n\\\"c\\n\\nd\\\",e\\n\"", show(C.Csv.parse("a,b\n\n\"c\n\nd\",e\n", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Closing Quote: got \",\" at line 5 instead of delimiter, record delimiter, trimable character (if activated) or comment"},
