    T.Check{"HBLRXS d=\"\\t\" q=\"\\\"\" e=\"\\\"\" \",\\n,\\n\"", show(C.Csv.parse(",\n,\n", C.Options{True{}, True{}, "\t", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\",\":\",\"}]"},
