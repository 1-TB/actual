    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \",a\"", show(C.Csv.parse(",a", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\",a\"]]"},
