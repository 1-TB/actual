    T.Check{"-B--XS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\"", show(C.Csv.parse("", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, False{}, False{}, True{}, True{}})), "[]"},
