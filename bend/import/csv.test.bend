    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"\\r\\\"b\\\"\\r\"", show(C.Csv.parse("\"a\"\r\"b\"\r", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"b\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,\\n\"", show(C.Csv.parse("a,b,\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
