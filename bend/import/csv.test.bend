    T.Check{"random 13: HBLRXS d=\",\" q=\"'\" e=null \"  \\\"\"", show(C.Csv.parse("  \"", C.Options{True{}, True{}, ",", Some{Chr{39}}, None{}, True{}, True{}, True{}, True{}})), "[]"},
