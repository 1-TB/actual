    T.Check{"random 9: --L-XS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\u{e9}\"", show(C.Csv.parse("\u{e9}", C.Options{False{}, False{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, False{}, True{}, True{}})), "[[\"\u{e9}\"]]"},
    T.Check{"random 10: --L-X- d=\";\" q=\"\\\"\" e=null \"\u{a0}\u{e9}\\\"\"", show(C.Csv.parse("\u{a0}\u{e9}\"", C.Options{False{}, False{}, ";", Some{Chr{34}}, None{}, True{}, False{}, True{}, False{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 1, value is \"\u{e9}\""},
    T.Check{"random 11: --LR-S d=\",\" q=\"\\\"\" e=\"\\\"\" \"1\"", show(C.Csv.parse("1", C.Options{False{}, False{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, False{}, True{}})), "[[\"1\"]]"},
