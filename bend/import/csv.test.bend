    T.Check{"random 18: -BLRX- d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{a0}\u{feff}\\n\\r\\n\u{feff}  '\\t\\\"\\n\"", show(C.Csv.parse("\u{a0}\u{feff}\n\r\n\u{feff}  '\t\"\n", C.Options{False{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, False{}})), "ERR Invalid Opening Quote: a quote is found on field 0 at line 4, value is \"'\\t\""},
