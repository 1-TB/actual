    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\n\\n\"", show(C.Csv.parse("a,b\n1,2\n\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\n   \"", show(C.Csv.parse("a,b\n1,2\n   ", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"0,1,00,01,1.5,-1,4294967294,4294967295\\na,b,c,d,e,f,g,h\"", show(C.Csv.parse("0,1,00,01,1.5,-1,4294967294,4294967295\na,b,c,d,e,f,g,h", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"0\":\"a\",\"1\":\"b\",\"4294967294\":\"g\",\"00\":\"c\",\"01\":\"d\",\"1.5\":\"e\",\"-1\":\"f\",\"4294967295\":\"h\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"__proto__,constructor\\n1,2\"", show(C.Csv.parse("__proto__,constructor\n1,2", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"__proto__\":\"1\",\"constructor\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a , b\\n\\\"x\\\" , \\\"y\\\"\"", show(C.Csv.parse("a , b\n\"x\" , \"y\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"x\",\"b\":\"y\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a,b\\\",c\\n\\\"1\\n2\\\",3\"", show(C.Csv.parse("\"a,b\",c\n\"1\n2\",3", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a,b\":\"1\\n2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,'b,c'\\n\"", show(C.Csv.parse("a,'b,c'\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,\\\"2\\n\"", show(C.Csv.parse("a,b\n1,\"2\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 2"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n1,2\\\"\\n\"", show(C.Csv.parse("a,b\n1,2\"\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Invalid Opening Quote: a quote is found on field \"b\" at line 2, value is \"2\""},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\u{2028}b,c\u{2029}\\n\"", show(C.Csv.parse("a\u{2028}b,c\u{2029}\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"Date,Payee,Amount\\n2025.12.04,Caf\u{e9} R\u{e9}my,100.25\\n2025.12.05,\\\"Boulangerie, M\u{fc}ller\\\",-42.10\\n\"", show(C.Csv.parse("Date,Payee,Amount\n2025.12.04,Caf\u{e9} R\u{e9}my,100.25\n2025.12.05,\"Boulangerie, M\u{fc}ller\",-42.10\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"Date\":\"2025.12.04\",\"Payee\":\"Caf\u{e9} R\u{e9}my\",\"Amount\":\"100.25\"},{\"Date\":\"2025.12.05\",\"Payee\":\"Boulangerie, M\u{fc}ller\",\"Amount\":\"-42.10\"}]"},
    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"\"", show(C.Csv.parse("", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\n\"", show(C.Csv.parse("a,b,c\n", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a,b,c\"]]"},
