    T.Check{"-BLRXS d=\";\" q=\"\\\"\" e=\"\\\"\" \" a , b ,c \\n  1,2  , 3\"", show(C.Csv.parse(" a , b ,c \n  1,2  , 3", C.Options{False{}, True{}, ";", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[[\"a , b ,c\"],[\"1,2  , 3\"]]"},
