    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"a\\\"\\\"\\\"\"", show(C.Csv.parse("\"a\"\"\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\"\\\"\\\"\"", show(C.Csv.parse("\"\"\"\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\"\\\"\"", show(C.Csv.parse("\"\"\"", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "ERR Quote Not Closed: the parsing is finished with an opening quote at line 1"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,,c\\n,,\\n,\"", show(C.Csv.parse("a,,c\n,,\n,", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"\",\"\":\"\",\"c\":\"\"},{\"a\":\"\",\"\":\"\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \",\\n,\\n\"", show(C.Csv.parse(",\n,\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"\":\"\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \" , \\n\"", show(C.Csv.parse(" , \n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"   \\n  \\n\"", show(C.Csv.parse("   \n  \n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\\n   \\nb\"", show(C.Csv.parse("a\n   \nb", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"b\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b,c\\n1,2\\n1,2,3,4\\n\"", show(C.Csv.parse("a,b,c\n1,2\n1,2,3,4\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"},{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"h1,h2\\n1\\n1,2,3\\n\"", show(C.Csv.parse("h1,h2\n1\n1,2,3\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"h1\":\"1\"},{\"h1\":\"1\",\"h2\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"x,x,y\\n1,2,3\\n\"", show(C.Csv.parse("x,x,y\n1,2,3\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"x\":\"2\",\"y\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"2,1,b,10,a\\nv2,v1,vb,v10,va\\n\"", show(C.Csv.parse("2,1,b,10,a\nv2,v1,vb,v10,va\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"1\":\"v1\",\"2\":\"v2\",\"10\":\"v10\",\"b\":\"vb\",\"a\":\"va\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,,b\\n1,2,3\\n\"", show(C.Csv.parse("a,,b\n1,2,3\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"\":\"2\",\"b\":\"3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\\\"\\\",h\\n1,2\"", show(C.Csv.parse("\"\",h\n1,2", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"\":\"1\",\"h\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a;b;c\\n1;2;3\"", show(C.Csv.parse("a;b;c\n1;2;3", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a;b;c\":\"1;2;3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a\\tb\\tc\\n1\\t2\\t3\"", show(C.Csv.parse("a\tb\tc\n1\t2\t3", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\\tb\\tc\":\"1\\t2\\t3\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a||b||c\\n1||2|3||4\"", show(C.Csv.parse("a||b||c\n1||2|3||4", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a||b||c\":\"1||2|3||4\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\u{e9},\u{20ac}\\n\u{fc},\u{1f600},z\"", show(C.Csv.parse("a,b\u{e9},\u{20ac}\n\u{fc},\u{1f600},z", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"\u{fc}\",\"b\u{e9}\":\"\u{1f600}\",\"\u{20ac}\":\"z\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}a,b\\n1,2\"", show(C.Csv.parse("\u{feff}a,b\n1,2", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\\"a\\\",b\\n1,2\"", show(C.Csv.parse("\u{feff}\"a\",b\n1,2", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"1\",\"b\":\"2\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"a,b\\n\u{feff}\\\"c\\\",d\"", show(C.Csv.parse("a,b\n\u{feff}\"c\",d", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[{\"a\":\"c\",\"b\":\"d\"}]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\"", show(C.Csv.parse("\u{feff}", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
    T.Check{"HBLRXS d=\",\" q=\"\\\"\" e=\"\\\"\" \"\u{feff}\\n\"", show(C.Csv.parse("\u{feff}\n", C.Options{True{}, True{}, ",", Some{Chr{34}}, Some{Chr{34}}, True{}, True{}, True{}, True{}})), "[]"},
