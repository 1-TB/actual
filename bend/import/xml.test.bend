def show(r: Result<&2, &2, String, Maybe<&2, J.Json>>) -> String:
  match r:
    case Fail{e}:
      "ERR " ++ e
    case Done{None{}}:
      "null"
    case Done{Some{j}}:
      J.Json.show(j)

def xml(text: String, trim: Bool) -> String:
  show(M.Xml.parse(text, trim))

