    T.Check{"random 0: trim=true \"<a></b>text<?p?><a>text&#65;>\"", xml("<a></b>text<?p?><a>text&#65;>", True{}), "ERR Unexpected close tag"},
    T.Check{"random 1: trim=true \"<?p?><a></a>\"", xml("<?p?><a></a>", True{}), "{\"a\":\"\"}"},
