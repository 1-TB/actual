    T.Check{"random 6: trim=false \"<a>&#65;\\n\\\"<<?p?><!DOCTYPE a></a>\"", xml("<a>&#65;\n\"<<?p?><!DOCTYPE a></a>", False{}), "ERR Unencoded <"},
    T.Check{"random 7: trim=true \"<a><![CDATA[d]]><!--c--><!<!--c-->>\"", xml("<a><![CDATA[d]]><!--c--><!<!--c-->>", True{}), "ERR Unclosed root tag"},
    T.Check{"random 8: trim=false \"<a></a>]>><b></c>\"", xml("<a></a>]>><b></c>", False{}), "{\"a\":\"\"}"},
    T.Check{"random 9: trim=false \"]&amp; </a>\"", xml("]&amp; </a>", False{}), "ERR Non-whitespace before first tag."},
    T.Check{"random 10: trim=true \"<a>&amp;&amp;-<?p?>x<!DOCTYPE a></a>\"", xml("<a>&amp;&amp;-<?p?>x<!DOCTYPE a></a>", True{}), "ERR Inappropriately located doctype declaration"},
    T.Check{"random 11: trim=true \"<a><!DOCTYPE a>x</b></b><!]\\\"</a>\"", xml("<a><!DOCTYPE a>x</b></b><!]\"</a>", True{}), "ERR Inappropriately located doctype declaration"},
    T.Check{"random 12: trim=true \"<a>&\"", xml("<a>&", True{}), "ERR Unclosed root tag"},
    T.Check{"random 13: trim=false \"]</a>\"", xml("]</a>", False{}), "ERR Non-whitespace before first tag."},
    T.Check{"random 14: trim=true \"<a><<!DOCTYPE a><c x=\\\"1\\\"><a>= text</a>\"", xml("<a><<!DOCTYPE a><c x=\"1\"><a>= text</a>", True{}), "ERR Unencoded <"},
    T.Check{"random 15: trim=true \"<text<a x=\\\"1\\\" y=\\\"2\\\">]x</c>=\"", xml("<text<a x=\"1\" y=\"2\">]x</c>=", True{}), "ERR Invalid character in tag name"},
    T.Check{"random 16: trim=false \">\\n&amp; \"", xml(">\n&amp; ", False{}), "ERR Non-whitespace before first tag."},
    T.Check{"random 17: trim=true \"<b><b/><b><!<?p?></a>\"", xml("<b><b/><b><!<?p?></a>", True{}), "ERR Unexpected close tag"},
    T.Check{"random 18: trim=true \"&amp;</a>\"", xml("&amp;</a>", True{}), "ERR Non-whitespace before first tag."},
    T.Check{"random 19: trim=true \"<a x=\\\"1\\\" y=\\\"2\\\"><c x=\\\"1\\\"><!DOCTYPE a>text<b>-</a>\"", xml("<a x=\"1\" y=\"2\"><c x=\"1\"><!DOCTYPE a>text<b>-</a>", True{}), "ERR Inappropriately located doctype declaration"},
    T.Check{"random 20: trim=false \"<!==/&#65;\\n=</a>\"", xml("<!==/&#65;\n=</a>", False{}), "null"},
