import ./js.bend as X
import ./camt.bend as K

def val(m: Maybe<&2, J.Json>) -> J.Json:
  match m:
    case None{}:
      J.JNull{}
    case Some{j}:
      j

def txn(t: K.Camt.Txn) -> J.Json:
  match t:
    case K.Txn{amount, date, payee, imported, notes, id}:
      J.Json.object([J.Member{"amount", J.JDec{N.Num.show(amount)}}, J.Member{"date", date},
        J.Member{"payee_name", val(payee)}, J.Member{"imported_payee", val(imported)},
        J.Member{"notes", val(notes)}, J.Member{"imported_id", val(id)}])

def show(r: Result<&2, &2, String, List<&2, K.Camt.Txn>>) -> String:
  match r:
    case Fail{e}:
      "ERR " ++ e
    case Done{txns}:
      J.Json.show(J.Json.array(X.Js.map(~K.Camt.Txn, ~J.Json, ~txn, txns)))

def camt(text: String) -> String:
  show(K.Camt.parse(text))

