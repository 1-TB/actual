    case P.Parsed{errors, transactions}:
      J.Json.show(J.Json.object([
        J.Member{"errors", J.Json.array(X.Js.map(~P.Parse.Error, ~J.Json, ~error, errors))},
        J.Member{"transactions", txns(transactions)}]))

