        J.Member{"notes", val(notes)}, J.Member{"category", val(category)}, J.Member{"imported_id", val(id)}])
    case P.Row{fields}:
      J.Json.array(X.Js.map(~String, ~J.Json, ~(s => J.JStr{s}), fields))
    case P.Record{entries}:
      J.Json.object(X.Js.map(~X.Js.Entry<String>, ~J.Json.Member, ~member, entries))

def error(e: P.Parse.Error) -> J.Json:
  match e:
    case P.Error{message, internal}:
      J.Json.object([J.Member{"message", J.JStr{message}}, J.Member{"internal", J.JStr{internal}}])

def txns(m: Maybe<&2, List<&2, P.Parse.Txn>>) -> J.Json:
