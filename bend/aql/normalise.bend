# The entries of the table for the code points `block` * 256 + 0..255: each
# is a code point, its normalised code points, and a 0.
def Norm.table(block: U32) -> List<&2, U32>:
  match block:
    case 0:
      Norm.table_0()
    case 1:
      Norm.table_1()
    case 2:
      Norm.table_2()
    case 3:
      Norm.table_3()
    case 4:
      Norm.table_4()
    case 5:
      Norm.table_5()
    case 6:
      Norm.table_6()
    case 7:
      Norm.table_7()
    case 8:
      Norm.table_8()
    case 9:
      Norm.table_9()
    case 10:
      Norm.table_10()
    case 11:
      Norm.table_11()
    case 12:
      Norm.table_12()
    case 13:
      Norm.table_13()
    case 14:
      Norm.table_14()
    case 15:
      Norm.table_15()
    case 16:
      Norm.table_16()
    case 19:
      Norm.table_19()
    case 23:
      Norm.table_23()
    case 25:
      Norm.table_25()
    case 26:
      Norm.table_26()
    case 27:
      Norm.table_27()
    case 28:
      Norm.table_28()
    case 29:
      Norm.table_29()
    case 30:
      Norm.table_30()
    case 31:
      Norm.table_31()
    case other:
      Nil{}

# The code points up to the next 0, as text.
def Norm.take(xs: List<&2, U32>) -> String:
  match xs:
    case Nil{}:
      SNil{}
    case Con{0, t}:
      SNil{}
    case Con{h, t}:
      SCon{Chr{h}, Norm.take(t)}

# The list after the next 0.
def Norm.skip(xs: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{0, t}:
      t
    case Con{h, t}:
      Norm.skip(t)

# The normalised text of x in a table whose head starts an entry; x itself
# when no entry is for it. Each step drops at least the entry's code point.
def Norm.find(+fuel: Nat, +xs: List<&2, U32>, +x: U32) -> String:
  match fuel xs:
    case 0n _:
      SCon{Chr{x}, SNil{}}
    case 1n+f Nil{}:
      SCon{Chr{x}, SNil{}}
    case 1n+f Con{+h, +t}:
      C.If(String, U32.is_eq(h, x),
        u => Norm.take(t),
        u => Norm.find(f, Norm.skip(t), x))

# The normalised text of one code point.
def Norm.chr(+x: U32) -> String:
  Norm.find(256n, Norm.table((x >> 8n : U32)), x)

# `getNormalisedString(value)`.
def Norm.string(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{Chr{x}, t}:
      String.append(Norm.chr(x), Norm.string(t))
