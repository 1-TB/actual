# `getNormalisedString` of packages/loot-core/src/shared/normalisation.ts:
# lowercase, the letters l/o/ss/oe for their look-alikes, canonical
# decomposition (NFD) and no diacritics.
#
# Bend has no Unicode tables, so this file holds one, generated from the JS
# function itself (scratchpad aql/normgen.mjs): each code point below U+2000
# (Latin, Greek, Cyrillic, Armenian, Georgian, ...) maps to what the JS
# function answers for it alone. Deviations: code points from U+2000 up are
# kept as they are (Hangul syllables are not decomposed, fullwidth capitals
# are not lowered), and the mapping is per code point, so the one
# context-sensitive rule of `toLowerCase` (a final capital sigma becomes the
# final small sigma) is not applied.
import Base
import ../lib/core.bend as C

