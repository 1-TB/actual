# Internal table filters that the compiler refuses, and expression stacks.
# Generated by the scratchpad script aql/gen_tests.ts, which runs the TS compiler
# (`generateSQLWithState`) over each query; `want` is its SQL and state, or
# the message of the error it throws.
import Base
import ../lib/test.bend as T
import ./types.bend as S
import ./schema.bend as M
import ./testing.bend as X

def schema_refs() -> S.Schema:
  X.Testing.schema("{\"transactions\":{\"id\":{\"type\":\"id\"},\"payee\":{\"type\":\"id\",\"ref\":\"payees\"},\"date\":{\"type\":\"date\"},\"amount\":{\"type\":\"integer\"}},\"payees\":{\"name\":{\"type\":\"string\"},\"id\":{\"type\":\"id\"},\"account\":{\"type\":\"id\",\"ref\":\"accounts\"}},\"accounts\":{\"id\":{\"type\":\"id\"},\"trans1\":{\"type\":\"id\",\"ref\":\"transactions\"},\"trans2\":{\"type\":\"id\",\"ref\":\"transactions\"},\"trans3\":{\"type\":\"id\",\"ref\":\"transactions\"}}}")

def config_badarray() -> S.Config:
  X.Testing.config("{\"tableFilters\":{\"transactions\":[[{\"amount\":1}]]}}")

def config_badpath() -> S.Config:
  X.Testing.config("{\"tableViews\":{\"transactions\":\"v_transactions\"},\"tableFilters\":{\"transactions\":[{\"payee.name\":\"foo\"}]}}")

def config_none() -> S.Config:
  X.Testing.config("{}")

def config_custom() -> S.Config:
  X.Testing.config("{\"tableViews\":{\"transactions\":\"v_transactions\"},\"tableFilters\":{\"transactions\":[{\"amount\":{\"$gt\":0}}]}}")

def main() -> IO(Unit):
  T.Test.run([
    T.Check{"array internal filter",
      X.Testing.run(schema_refs(), config_badarray(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Invalid internal table filter: only object filters are supported"},
    T.Check{"array internal filter joined",
      X.Testing.run(schema_refs(), config_badarray(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"trans1.amount\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"accounts\"}"),
      "ERROR: Invalid internal table filter: only object filters are supported"},
    T.Check{"array internal filter raw joined",
      X.Testing.run(schema_refs(), config_badarray(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"trans1.amount\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":true,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"accounts\"}"),
      "ERROR: Invalid internal table filter: only object filters are supported"},
    T.Check{"path internal filter raw",
      X.Testing.run(schema_refs(), config_badpath(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":true,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT v_transactions.id AS id FROM v_transactions\n    \n    \n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
    T.Check{"path internal filter root",
      X.Testing.run(schema_refs(), config_badpath(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Invalid internal table filter: field names cannot contain paths"},
    T.Check{"stack: one select string",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"nope\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  select(nope)"},
    T.Check{"stack: two selects",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\",\"nope\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  select([\"id\",\"nope\"])"},
    T.Check{"stack: select star",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"nope.*\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field not joinable on table transactions: \"nope\"\n\nExpression stack:\n  select(nope.*)"},
    T.Check{"stack: nested function",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[{\"x\":{\"$neg\":{\"$abs\":{\"$idiv\":[\"$amount\",\"$nope\"]}}}}],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  {\"$idiv\":[\"$amount\",\"$nope\"]}\n  {\"$idiv\":[\"$amount\",\"$nope\"]}\n  {\"$abs\":{\"$idiv\":[\"$amount\",\"$nope\"]}}\n  {\"$abs\":{\"$idiv\":[\"$amount\",\"$nope\"]}}\n  {\"$neg\":{\"$abs\":{\"$idiv\":[\"$amount\",\"$nope\"]}}}\n  select({\"x\":{\"$neg\":{\"$abs\":{\"$idiv\":[\"$amount\",\"$nope\"]}}}})"},
    T.Check{"stack: filter two",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[{\"amount\":1},{\"nope\":2}],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  {\"nope\":{\"$eq\":2}}\n  filter([{\"amount\":1},{\"nope\":2}])"},
    T.Check{"stack: or",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[{\"$or\":[{\"amount\":1},{\"amount\":{\"$gt\":\"x\"}}]}],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Can't convert string to integer\n\nExpression stack:\n  {\"amount\":{\"$gt\":\"x\"}}\n  filter({\"$or\":[{\"amount\":1},{\"amount\":{\"$gt\":\"x\"}}]})"},
    T.Check{"stack: transform",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[{\"date\":{\"$transform\":{\"$year\":\"$nope\"},\"$eq\":\"2020\"}}],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  {\"$year\":\"$nope\"}\n  {\"date\":{\"$transform\":{\"$year\":\"$nope\"},\"$eq\":\"2020\"}}\n  filter({\"date\":{\"$transform\":{\"$year\":\"$nope\"},\"$eq\":\"2020\"}})"},
    T.Check{"stack: too many args",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[{\"x\":{\"$neg\":[1,2]}}],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Too many arguments\n\nExpression stack:\n  {\"$neg\":[1,2]}\n  select({\"x\":{\"$neg\":[1,2]}})"},
    T.Check{"stack: bad order direction",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[{\"amount\":\"sideways\"},\"id\"],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Invalid order direction: sideways\n\nExpression stack:\n  orderBy([{\"amount\":\"sideways\"},\"id\"])"},
    T.Check{"stack: sumOver orders",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[{\"x\":{\"$sumOver\":\"$amount\"}}],\"groupExpressions\":[],\"orderExpressions\":[{\"$neg\":\"$nope\"}],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Field \"nope\" does not exist in table \"transactions\"\n\nExpression stack:\n  $nope\n  {\"$neg\":\"$nope\"}\n  \n  {\"$sumOver\":\"$amount\"}\n  select({\"x\":{\"$sumOver\":\"$amount\"}})"},
    T.Check{"stack: unnamed function",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\",{\"$neg\":\"$amount\"}],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Invalid field \"$neg\", are you trying to select a function? You need to name the expression\n\nExpression stack:\n  {\"$neg\":\"$amount\"}\n  select([\"id\",{\"$neg\":\"$amount\"}])"},
    T.Check{"stack: groupBy list",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[\"amount\",{\"$nope\":1}],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "ERROR: Unknown function: $nope\n\nExpression stack:\n  {\"$nope\":1}\n  groupBy([\"amount\",{\"$nope\":1}])"},
    T.Check{"stack: internal filter root",
      X.Testing.run(schema_refs(), config_custom(), "{\"tableOptions\":{},\"filterExpressions\":[],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT v_transactions.id AS id FROM v_transactions\n    \n    WHERE (v_transactions.amount > 0)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "}
  ])
