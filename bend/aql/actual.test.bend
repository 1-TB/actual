      "\n    SELECT v_schedules.id AS id, v_schedules.next_date AS next_date FROM v_schedules\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_schedules._account AND accounts1.tombstone = 0\n    WHERE (v_schedules.next_date <= 20240630\n  AND accounts1.closed = 0) AND v_schedules.tombstone = 0\n    \n    ORDER BY v_schedules.completed = 1, v_schedules.next_date\n    \n    \n  \n--paths schedules._account=accounts/accounts1/_account/schedules\n--deps schedules,accounts\n--types id:id,next_date:date\n--params "},
