      "\n    SELECT v_schedules.id AS id, v_schedules.name AS name, rules1.id AS rule, v_schedules.next_date AS next_date, v_schedules.completed AS completed, v_schedules.posts_transaction AS posts_transaction, v_schedules.custom_upcoming_length AS custom_upcoming_length, v_schedules.tombstone AS tombstone, v_schedules.sort_order AS sort_order, payees2.id AS _payee, accounts3.id AS _account, v_schedules._amount AS _amount, v_schedules._amountOp AS _amountOp, v_schedules._date AS _date, v_schedules._conditions AS _conditions, v_schedules._actions AS _actions, v_schedules._has_splits AS _has_splits FROM v_schedules\n    LEFT JOIN rules rules1 ON rules1.id = v_schedules.rule AND rules1.tombstone = 0\nLEFT JOIN v_payees payees2 ON payees2.id = v_schedules._payee AND payees2.tombstone = 0\nLEFT JOIN accounts accounts3 ON accounts3.id = v_schedules._account AND accounts3.tombstone = 0\n    WHERE (v_schedules.completed = 0) AND v_schedules.tombstone = 0\n    \n    ORDER BY v_schedules.completed = 1, v_schedules.next_date\n    \n    \n  \n--paths schedules.rule=rules/rules1/rule/schedules;schedules._payee=payees/payees2/_payee/schedules;schedules._account=accounts/accounts3/_account/schedules\n--deps schedules,rules,payees,accounts\n--types id:id,name:string,rule:id,next_date:date,completed:boolean,posts_transaction:boolean,custom_upcoming_length:string,tombstone:boolean,sort_order:float,_payee:id,_account:id,_amount:json/fallback,_amountOp:string,_date:json/fallback,_conditions:json,_actions:json,_has_splits:boolean\n--params "},
