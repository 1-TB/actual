      "\n    SELECT v_payees.id AS id, v_payees.name AS name, accounts1.id AS transfer_acct, v_payees.tombstone AS tombstone, v_payees.favorite AS favorite, v_payees.learn_categories AS learn_categories FROM v_payees\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_payees.transfer_acct AND accounts1.tombstone = 0\n    WHERE v_payees.tombstone = 0\n    \n    ORDER BY v_payees.name, v_payees.id\n    \n    \n  \n--paths payees.transfer_acct=accounts/accounts1/transfer_acct/payees\n--deps payees,accounts\n--types id:id,name:string,transfer_acct:id,tombstone:boolean,favorite:boolean,learn_categories:boolean\n--params "},
