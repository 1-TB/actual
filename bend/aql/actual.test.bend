      "\n    SELECT v_transactions_internal_alive.id AS id FROM v_transactions_internal_alive\n    \n    WHERE (REGEXP('(?<!#)#tag(?=\\s|$)', v_transactions_internal_alive.notes)) AND v_transactions_internal_alive.tombstone = 0\n    \n    ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id\n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
