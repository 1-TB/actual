    T.Check{"transactions balance",
      X.Testing.run(M.Actual.schema(), M.Actual.config(), "{\"tableOptions\":{},\"filterExpressions\":[{\"account.offbudget\":false,\"date\":{\"$lte\":\"2024-05-31\"}}],\"selectExpressions\":[{\"result\":{\"$sum\":\"$amount\"}}],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":true,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT SUM(v_transactions_internal_alive.amount) AS result FROM v_transactions_internal_alive\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_transactions_internal_alive.account AND accounts1.tombstone = 0\n    WHERE (accounts1.offbudget = 0\n  AND v_transactions_internal_alive.date <= 20240531) AND v_transactions_internal_alive.tombstone = 0\n    \n    ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id\n    \n    \n  \n--paths transactions.account=accounts/accounts1/account/transactions\n--deps transactions,accounts\n--types result:integer\n--params "},
    T.Check{"transactions by month",
      X.Testing.run(M.Actual.schema(), M.Actual.config(), "{\"tableOptions\":{},\"filterExpressions\":[{\"$and\":[{\"date\":{\"$gte\":\"2024-01-01\"}},{\"date\":{\"$lte\":\"2024-12-31\"}}],\"account.closed\":false}],\"selectExpressions\":[{\"month\":{\"$month\":\"$date\"}},{\"amount\":{\"$sum\":\"$amount\"}}],\"groupExpressions\":[{\"$month\":\"$date\"}],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT CAST(SUBSTR(v_transactions_internal_alive.date, 1, 6) AS integer) AS month, SUM(v_transactions_internal_alive.amount) AS amount FROM v_transactions_internal_alive\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_transactions_internal_alive.account AND accounts1.tombstone = 0\n    WHERE ((v_transactions_internal_alive.date >= 20240101\n  AND v_transactions_internal_alive.date <= 20241231)\n  AND accounts1.closed = 0) AND v_transactions_internal_alive.tombstone = 0\n    GROUP BY CAST(SUBSTR(v_transactions_internal_alive.date, 1, 6) AS integer)\n    ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id\n    \n    \n  \n--paths transactions.account=accounts/accounts1/account/transactions\n--deps transactions,accounts\n--types month:date-month,amount:integer\n--params "},
    T.Check{"transactions search",
      X.Testing.run(M.Actual.schema(), M.Actual.config(), "{\"tableOptions\":{},\"filterExpressions\":[{\"$or\":[{\"payee.name\":{\"$like\":\"%Café%\"}},{\"notes\":{\"$like\":\"%Café%\"}},{\"category.name\":{\"$like\":\"%Café%\"}}]}],\"selectExpressions\":[\"*\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":50,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT v_transactions_internal_alive.id AS id, v_transactions_internal_alive.is_parent AS is_parent, v_transactions_internal_alive.is_child AS is_child, v_transactions_internal_alive.parent_id AS parent_id, accounts1.id AS account, categories2.id AS category, v_transactions_internal_alive.amount AS amount, payees3.id AS payee, v_transactions_internal_alive.notes AS notes, v_transactions_internal_alive.date AS date, v_transactions_internal_alive.imported_id AS imported_id, v_transactions_internal_alive.error AS error, v_transactions_internal_alive.imported_payee AS imported_payee, v_transactions_internal_alive.starting_balance_flag AS starting_balance_flag, v_transactions_internal_alive.transfer_id AS transfer_id, v_transactions_internal_alive.sort_order AS sort_order, v_transactions_internal_alive.cleared AS cleared, v_transactions_internal_alive.reconciled AS reconciled, v_transactions_internal_alive.tombstone AS tombstone, schedules4.id AS schedule, v_transactions_internal_alive.raw_synced_data AS raw_synced_data FROM v_transactions_internal_alive\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_transactions_internal_alive.account AND accounts1.tombstone = 0\nLEFT JOIN v_categories categories2 ON categories2.id = v_transactions_internal_alive.category AND categories2.tombstone = 0\nLEFT JOIN v_payees payees3 ON payees3.id = v_transactions_internal_alive.payee AND payees3.tombstone = 0\nLEFT JOIN v_schedules schedules4 ON schedules4.id = v_transactions_internal_alive.schedule AND schedules4.tombstone = 0\n    WHERE ((UNICODE_LIKE('%cafe%', NORMALISE(payees3.name))\n  OR UNICODE_LIKE('%cafe%', NORMALISE(v_transactions_internal_alive.notes))\n  OR UNICODE_LIKE('%cafe%', NORMALISE(categories2.name)))) AND v_transactions_internal_alive.tombstone = 0\n    \n    ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id\n    LIMIT 50\n    \n  \n--paths transactions.account=accounts/accounts1/account/transactions;transactions.category=categories/categories2/category/transactions;transactions.payee=payees/payees3/payee/transactions;transactions.schedule=schedules/schedules4/schedule/transactions\n--deps transactions,accounts,categories,payees,schedules\n--types id:id,is_parent:boolean,is_child:boolean,parent_id:id,account:id,category:id,amount:integer,payee:id,notes:string,date:date,imported_id:string,error:json,imported_payee:string,starting_balance_flag:boolean,transfer_id:id,sort_order:float,cleared:boolean,reconciled:boolean,tombstone:boolean,schedule:id,raw_synced_data:string\n--params "},
    T.Check{"transactions running balance",
      X.Testing.run(M.Actual.schema(), M.Actual.config(), "{\"tableOptions\":{},\"filterExpressions\":[{\"account\":\":acct\"}],\"selectExpressions\":[{\"balance\":{\"$sumOver\":\"$amount\"}}],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT (SUM(v_transactions_internal_alive.amount) OVER (ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)) AS balance, v_transactions_internal_alive.id AS id FROM v_transactions_internal_alive\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_transactions_internal_alive.account AND accounts1.tombstone = 0\n    WHERE (CASE\n          WHEN accounts1.id IS NULL THEN ? IS NULL\n          ELSE accounts1.id = ?\n        END) AND v_transactions_internal_alive.tombstone = 0\n    \n    ORDER BY v_transactions_internal_alive.date desc, v_transactions_internal_alive.starting_balance_flag, v_transactions_internal_alive.sort_order desc, v_transactions_internal_alive.id\n    \n    \n  \n--paths transactions.account=accounts/accounts1/account/transactions\n--deps transactions,accounts\n--types balance:integer,id:id\n--params acct:id,acct:id"},
    T.Check{"transactions uncategorized",
