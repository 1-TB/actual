      "\n    SELECT payees1.name AS \"_payee.name\", accounts2.name AS \"_account.name\", rules3.conditions AS \"rule.conditions\", v_schedules.id AS id FROM v_schedules\n    LEFT JOIN v_payees payees1 ON payees1.id = v_schedules._payee AND payees1.tombstone = 0\nLEFT JOIN accounts accounts2 ON accounts2.id = v_schedules._account AND accounts2.tombstone = 0\nLEFT JOIN rules rules3 ON rules3.id = v_schedules.rule AND rules3.tombstone = 0\n    WHERE v_schedules.tombstone = 0\n    \n    ORDER BY v_schedules.completed = 1, v_schedules.next_date\n    \n    \n  \n--paths schedules._payee=payees/payees1/_payee/schedules;schedules._account=accounts/accounts2/_account/schedules;schedules.rule=rules/rules3/rule/schedules\n--deps schedules,payees,accounts,rules\n--types _payee.name:string,_account.name:string,rule.conditions:json,id:id\n--params "},
