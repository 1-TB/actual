      "\n    SELECT v_transactions_internal.id AS id, v_transactions_internal.is_parent AS is_parent, v_transactions_internal.is_child AS is_child, v_transactions_internal.parent_id AS parent_id, accounts1.id AS account, categories2.id AS category, v_transactions_internal.amount AS amount, payees3.id AS payee, v_transactions_internal.notes AS notes, v_transactions_internal.date AS date, v_transactions_internal.imported_id AS imported_id, v_transactions_internal.error AS error, v_transactions_internal.imported_payee AS imported_payee, v_transactions_internal.starting_balance_flag AS starting_balance_flag, v_transactions_internal.transfer_id AS transfer_id, v_transactions_internal.sort_order AS sort_order, v_transactions_internal.cleared AS cleared, v_transactions_internal.reconciled AS reconciled, v_transactions_internal.tombstone AS tombstone, schedules4.id AS schedule, v_transactions_internal.raw_synced_data AS raw_synced_data FROM v_transactions_internal\n    LEFT JOIN accounts accounts1 ON accounts1.id = v_transactions_internal.account AND accounts1.tombstone = 0\nLEFT JOIN v_categories categories2 ON categories2.id = v_transactions_internal.category AND categories2.tombstone = 0\nLEFT JOIN v_payees payees3 ON payees3.id = v_transactions_internal.payee AND payees3.tombstone = 0\nLEFT JOIN v_schedules schedules4 ON schedules4.id = v_transactions_internal.schedule AND schedules4.tombstone = 0\n    WHERE (v_transactions_internal.id IN ('a','b')) AND v_transactions_internal.tombstone = 0\n    \n    ORDER BY v_transactions_internal.date desc, v_transactions_internal.starting_balance_flag, v_transactions_internal.sort_order desc, v_transactions_internal.id\n    \n    \n  \n--paths transactions.account=accounts/accounts1/account/transactions;transactions.category=categories/categories2/category/transactions;transactions.payee=payees/payees3/payee/transactions;transactions.schedule=schedules/schedules4/schedule/transactions\n--deps transactions,accounts,categories,payees,schedules\n--types id:id,is_parent:boolean,is_child:boolean,parent_id:id,account:id,category:id,amount:integer,payee:id,notes:string,date:date,imported_id:string,error:json,imported_payee:string,starting_balance_flag:boolean,transfer_id:id,sort_order:float,cleared:boolean,reconciled:boolean,tombstone:boolean,schedule:id,raw_synced_data:string\n--params "},
    T.Check{"transactions tags",
