      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (transactions.id = 'foo')\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
    T.Check{"id field to id",
