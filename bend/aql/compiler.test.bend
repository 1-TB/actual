      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (transactions.amount < (-?))\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params amount:float"},
    T.Check{"named parameter type",
