      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (CASE\n          WHEN transactions.amount IS NULL THEN ? IS NULL\n          ELSE transactions.amount = ?\n        END)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params amount:integer,amount:integer"},
    T.Check{"named parameter in function",
