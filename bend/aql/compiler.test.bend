      "\n    SELECT accounts.id AS id FROM accounts\n    LEFT JOIN transactions transactions1 ON transactions1.id = accounts.trans1\n    WHERE (accounts.id = transactions1.id)\n    \n    \n    \n    \n  \n--paths accounts.trans1=transactions/transactions1/trans1/accounts\n--deps accounts,transactions\n--types id:id\n--params "},
