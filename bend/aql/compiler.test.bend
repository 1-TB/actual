      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[{\"date\":[{\"$lt\":\"2020-01-01\"}],\"$or\":[{\"payee.name\":\"foo\"},{\"payee.name\":\"bar\"}]}],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"transactions\"}"),
      "\n    SELECT transactions.id AS id FROM transactions\n    LEFT JOIN payees payees1 ON payees1.id = transactions.payee\n    WHERE (transactions.date < 20200101\n  AND (payees1.name = 'foo'\n  OR payees1.name = 'bar'))\n    \n    \n    \n    \n  \n--paths transactions.payee=payees/payees1/payee/transactions\n--deps transactions,payees\n--types id:id\n--params "},
    T.Check{"filter $or and $and",
