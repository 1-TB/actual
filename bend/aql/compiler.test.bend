      "\n    SELECT transactions.amount AS amount, transactions.id AS id FROM transactions\n    \n    WHERE (transactions.id IN ('one','two','three'))\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types amount:integer,id:id\n--params "},
