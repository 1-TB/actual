      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (CAST(SUBSTR(transactions.date, 1, 4) AS integer) = 2020)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
    T.Check{"date field to month",
      X.Testing.run(schema_refs(), config_none(), "{\"tableOptions\":{},\"filterExpressions\":[{\"trans1.date\":{\"$transform\":\"$month\",\"$eq\":\"$trans2.date\"}}],\"selectExpressions\":[\"id\"],\"groupExpressions\":[],\"orderExpressions\":[],\"calculation\":false,\"rawMode\":false,\"withDead\":false,\"validateRefs\":true,\"limit\":null,\"offset\":null,\"table\":\"accounts\"}"),
      "\n    SELECT accounts.id AS id FROM accounts\n    LEFT JOIN transactions transactions1 ON transactions1.id = accounts.trans2\nLEFT JOIN transactions transactions2 ON transactions2.id = accounts.trans1\n    WHERE (CAST(SUBSTR(transactions2.date, 1, 6) AS integer) = CAST(SUBSTR(transactions1.date, 1, 6) AS integer))\n    \n    \n    \n    \n  \n--paths accounts.trans2=transactions/transactions1/trans2/accounts;accounts.trans1=transactions/transactions2/trans1/accounts\n--deps accounts,transactions\n--types id:id\n--params "},
    T.Check{"date field to year",
