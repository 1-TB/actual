      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (CAST(SUBSTR(transactions.date, 1, 6) AS integer) = 202001)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
    T.Check{"date to month",
