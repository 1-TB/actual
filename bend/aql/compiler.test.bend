      "\n    SELECT v_transactions.amount AS amount, v_transactions.id AS id FROM v_transactions\n    \n    WHERE (v_transactions.amount > 0)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types amount:integer,id:id\n--params "},
    T.Check{"custom views and filters joined",
