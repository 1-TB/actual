      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE (transactions.date < 20200101 AND transactions.date > 20191201)\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
    T.Check{"filter referencing fields",
