      "\n    SELECT transactions.id AS id FROM transactions\n    \n    WHERE ((transactions.payee = 'payee1'\n  OR transactions.amount = 12))\n    \n    \n    \n    \n  \n--paths \n--deps transactions\n--types id:id\n--params "},
