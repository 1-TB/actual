# `basicSchema` of schema-helpers.test.ts, with a few more field types.
def schema() -> S.Schema:
  S.Schema{[S.Table{"transactions", [
    S.Field.of("id", "id"),
    S.Field.required(S.Field.of("date", "date")),
    S.Field.required(S.Field.of("account", "id")),
    S.Field.required(S.Field.default(S.Field.of("amount", "integer"), S.Value{J.Json.nat(0n)})),
    S.Field.default(S.Field.of("cleared", "boolean"), S.Value{J.JBool{True{}}}),
    S.Field.of("notes", "text"),
    S.Field.default(S.Field.of("sort_order", "float"), S.Now{}),
    S.Field.of("month", "date-month"),
    S.Field.of("year", "date-year"),
    S.Field.of("meta", "json"),
    S.Field.of("loose", "json/fallback"),
    S.Field.default(S.Field.of("nothing", "string"), S.Value{J.JNull{}})]}]}

def show(+r: Result<&2, &2, String, J.Json>) -> String:
  match r:
    case Fail{msg}:
      X.Testing.error(msg)
    case Done{j}:
      J.Json.show(j)

