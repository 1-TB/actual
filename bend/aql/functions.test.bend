      "\n    SELECT items.name AS name, SUM(items.price) AS total FROM items\n    LEFT JOIN groups groups1 ON groups1.id = items.\"group\" AND groups1.tombstone = 0\n    WHERE (items.day >= 20200101\n  AND UNICODE_LIKE('%food%', NORMALISE(groups1.name))) AND items.tombstone = 0\n    GROUP BY items.name\n    ORDER BY SUM(items.price) desc\n    LIMIT 10\n    OFFSET 20\n  \n--paths items.group=groups/groups1/group/items\n--deps items,groups\n--types name:string,total:float\n--params "},
