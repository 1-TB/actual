      "\n    SELECT groups1.name AS \"group.name\", items.id AS id FROM items\n    LEFT JOIN groups groups1 ON groups1.id = items.\"group\" AND (CASE\n          WHEN groups1.name IS NULL THEN ? IS NULL\n          ELSE groups1.name = ?\n        END) AND groups1.tombstone = 0\n    WHERE (CASE\n          WHEN items.count IS NULL THEN ? IS NULL\n          ELSE items.count = ?\n        END) AND (CASE\n          WHEN items.name IS NULL THEN ? IS NULL\n          ELSE items.name = ?\n        END) AND items.tombstone = 0\n    \n    \n    \n    \n  \n--paths items.group=groups/groups1/group/items\n--deps items,groups\n--types group.name:string,id:id\n--params c:integer,c:integer,iname:string,iname:string,gname:string"},
