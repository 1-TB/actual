      "\n    SELECT groups1.name AS \"group.name\", people.id AS id FROM people\n    LEFT JOIN v_groups groups1 ON groups1.id = people.\"group\" AND ((groups1.name != 'x' OR groups1.name IS NULL)\n  AND groups2.id IS NULL) AND groups1.tombstone = 0\nLEFT JOIN v_groups groups2 ON groups2.id = v_groups.parent AND ((groups2.name != 'x' OR groups2.name IS NULL)\n  AND groups2.id IS NULL) AND groups2.tombstone = 0\n    \n    \n    \n    \n    \n  \n--paths people.group=groups/groups1/group/people;groups.parent=groups/groups2/parent/groups\n--deps people,groups\n--types group.name:string,id:id\n--params "},
