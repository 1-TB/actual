      "\n    SELECT groups1.name AS \"group.name\", groups3.name AS \"owner.group.name\", v_items.id AS id FROM v_items\n    LEFT JOIN v_groups groups1 ON groups1.id = v_items.\"group\" AND ((groups1.name != 'x' OR groups1.name IS NULL)\n  AND groups4.id IS NULL) AND groups1.tombstone = 0\nLEFT JOIN people people2 ON people2.id = v_items.owner\nLEFT JOIN v_groups groups3 ON groups3.id = people2.\"group\" AND ((groups3.name != 'x' OR groups3.name IS NULL)\n  AND groups4.id IS NULL) AND groups3.tombstone = 0\nLEFT JOIN v_groups groups4 ON groups4.id = v_groups.parent AND ((groups4.name != 'x' OR groups4.name IS NULL)\n  AND groups4.id IS NULL) AND groups4.tombstone = 0\n    WHERE (CASE\n          WHEN v_items.name IS NULL THEN ? IS NULL\n          ELSE v_items.name = ?\n        END) AND (v_items.done = 0\n  AND v_items.count >= ?) AND v_items.tombstone = 0\n    \n    \n    \n    \n  \n--paths items.group=groups/groups1/group/items;items.owner=people/people2/owner/items;items.owner.group=groups/groups3/group/people2;groups.parent=groups/groups4/parent/groups\n--deps items,groups,people\n--types group.name:string,owner.group.name:string,id:id\n--params n:string,n:string,min:integer"},
