def show.default(+d: S.Default) -> String:
  match d:
    case S.NoDefault{}:
      ""
    case S.Value{json}:
      J.Json.show(json)
    case S.Now{}:
      "now"

def show.field(+f: S.Field) -> String:
  match f:
    case S.Field{name, kind, ref, required, default}:
      name ++ ":" ++ kind ++ ":" ++ Maybe.default(&2, String, ref, "") ++ ":" ++
        Bool.pick(String, required, "required", "") ++ ":" ++ show.default(default)

def show.fields(+fs: List<&2, S.Field>) -> List<&2, String>:
  match fs:
    case Nil{}:
      Nil{}
    case Con{f, rest}:
      show.field(f) <> show.fields(rest)

def show.tables(+ts: List<&2, S.Table>) -> List<&2, String>:
  match ts:
    case Nil{}:
      Nil{}
    case Con{S.Table{name, fields}, rest}:
      (name ++ "(" ++ String.join(show.fields(fields), " ") ++ ")") <> show.tables(rest)

# Every table with its fields: name, type, ref, required and default.
def show(+ts: List<&2, S.Table>) -> String:
  String.join(show.tables(ts), "\n")

