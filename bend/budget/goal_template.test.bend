def part_1() -> List<&2, T.Test.Check>:
  [
    T.Check{"#template 75% of previous Dining Out", parse("#template 75% of previous Dining Out"), "{\"type\":\"percentage\",\"percent\":75,\"previous\":true,\"category\":\"Dining Out\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 800 by 2025-09 repeat every year", parse("#template 800 by 2025-09 repeat every year"), "{\"type\":\"by\",\"amount\":800,\"month\":\"2025-09\",\"annual\":true,\"from\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 900 by 2025-08 repeat every 3 years", parse("#template 900 by 2025-08 repeat every 3 years"), "{\"type\":\"by\",\"amount\":900,\"month\":\"2025-08\",\"annual\":true,\"repeat\":3,\"from\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template and #goal", parse("#template and #goal"), "error"},
    T.Check{"#template average 3 months", parse("#template average 3 months"), "{\"type\":\"average\",\"numMonths\":3,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template average 3 months [decrease 10%]", parse("#template average 3 months [decrease 10%]"), "{\"type\":\"average\",\"numMonths\":3,\"priority\":0,\"directive\":\"template\",\"adjustment\":-10,\"adjustmentType\":\"percent\"}"},
    T.Check{"#template average 3 months [decrease 1]", parse("#template average 3 months [decrease 1]"), "{\"type\":\"average\",\"numMonths\":3,\"priority\":0,\"directive\":\"template\",\"adjustment\":-1,\"adjustmentType\":\"fixed\"}"},
    T.Check{"#template average 3 months [increase 11]", parse("#template average 3 months [increase 11]"), "{\"type\":\"average\",\"numMonths\":3,\"priority\":0,\"directive\":\"template\",\"adjustment\":11,\"adjustmentType\":\"fixed\"}"},
    T.Check{"#template average 3 months [increase 20%]", parse("#template average 3 months [increase 20%]"), "{\"type\":\"average\",\"numMonths\":3,\"priority\":0,\"directive\":\"template\",\"adjustment\":20,\"adjustmentType\":\"percent\"}"},
    T.Check{"#template average 4 weeks on friday", parse("#template average 4 weeks on friday"), "{\"type\":\"weeklyAverage\",\"numWeeks\":4,\"weekday\":\"friday\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template average 4 weeks on friday [increase 10%]", parse("#template average 4 weeks on friday [increase 10%]"), "{\"type\":\"weeklyAverage\",\"numWeeks\":4,\"weekday\":\"friday\",\"priority\":0,\"directive\":\"template\",\"adjustment\":10,\"adjustmentType\":\"percent\"}"},
    T.Check{"#template average 4 weeks on monday", parse("#template average 4 weeks on monday"), "{\"type\":\"weeklyAverage\",\"numWeeks\":4,\"weekday\":\"monday\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template average 4 weeks on monday [increase 5]", parse("#template average 4 weeks on monday [increase 5]"), "{\"type\":\"weeklyAverage\",\"numWeeks\":4,\"weekday\":\"monday\",\"priority\":0,\"directive\":\"template\",\"adjustment\":5,\"adjustmentType\":\"fixed\"}"},
    T.Check{"#template average 6 months", parse("#template average 6 months"), "{\"type\":\"average\",\"numMonths\":6,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template average {number} months", parse("#template average {number} months"), "error"},
    T.Check{"#template average {number} weeks on {weekday}", parse("#template average {number} weeks on {weekday}"), "error"},
    T.Check{"#template broken template", parse("#template broken template"), "error"},
    T.Check{"#template copy from 12 months ago", parse("#template copy from 12 months ago"), "{\"type\":\"copy\",\"priority\":0,\"directive\":\"template\",\"lookBack\":12,\"limit\":null}"},
    T.Check{"#template copy from 3 months ago", parse("#template copy from 3 months ago"), "{\"type\":\"copy\",\"priority\":0,\"directive\":\"template\",\"lookBack\":3,\"limit\":null}"},
    T.Check{"#template copy from 6 months ago", parse("#template copy from 6 months ago"), "{\"type\":\"copy\",\"priority\":0,\"directive\":\"template\",\"lookBack\":6,\"limit\":null}"},
    T.Check{"#template remainder", parse("#template remainder"), "{\"type\":\"remainder\",\"priority\":null,\"directive\":\"template\",\"weight\":1,\"limit\":null}"},
    T.Check{"#template remainder 2", parse("#template remainder 2"), "{\"type\":\"remainder\",\"priority\":null,\"directive\":\"template\",\"weight\":2,\"limit\":null}"},
    T.Check{"#template remainder 3 up to 10", parse("#template remainder 3 up to 10"), "{\"type\":\"remainder\",\"priority\":null,\"directive\":\"template\",\"weight\":3,\"limit\":{\"amount\":10,\"hold\":null,\"period\":\"monthly\",\"start\":null}}"},
    T.Check{"#template remainder 3 up to 40", parse("#template remainder 3 up to 40"), "{\"type\":\"remainder\",\"priority\":null,\"directive\":\"template\",\"weight\":3,\"limit\":{\"amount\":40,\"hold\":null,\"period\":\"monthly\",\"start\":null}}"},
    T.Check{"#template schedule", parse("#template schedule"), "error"},
    T.Check{"#template schedule Insurance [increase 20%]", parse("#template schedule Insurance [increase 20%]"), "{\"type\":\"schedule\",\"name\":\"Insurance\",\"priority\":0,\"directive\":\"template\",\"full\":null,\"adjustment\":20,\"adjustmentType\":\"percent\"}"},
    T.Check{"#template schedule Insurance [increase 500]", parse("#template schedule Insurance [increase 500]"), "{\"type\":\"schedule\",\"name\":\"Insurance\",\"priority\":0,\"directive\":\"template\",\"full\":null,\"adjustment\":500,\"adjustmentType\":\"fixed\"}"},
    T.Check{"#template schedule Internet", parse("#template schedule Internet"), "{\"type\":\"schedule\",\"name\":\"Internet\",\"priority\":0,\"directive\":\"template\",\"full\":null}"},
