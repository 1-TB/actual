    T.Check{"#template 1000 by 2025-07 spend from 2025-01 repeat every month", parse("#template 1000 by 2025-07 spend from 2025-01 repeat every month"), "{\"type\":\"spend\",\"amount\":1000,\"month\":\"2025-07\",\"annual\":false,\"from\":\"2025-01\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10000 by 2025-12", parse("#template 10000 by 2025-12"), "{\"type\":\"by\",\"amount\":10000,\"month\":\"2025-12\",\"from\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 1100 by 2025-06 spend from 2025-02 repeat every 2 months", parse("#template 1100 by 2025-06 spend from 2025-02 repeat every 2 months"), "{\"type\":\"spend\",\"amount\":1100,\"month\":\"2025-06\",\"annual\":false,\"repeat\":2,\"from\":\"2025-02\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 12% of available funds", parse("#template 12% of available funds"), "{\"type\":\"percentage\",\"percent\":12,\"previous\":false,\"category\":\"available funds\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 15% of all income", parse("#template 15% of all income"), "{\"type\":\"percentage\",\"percent\":15,\"previous\":false,\"category\":\"all income\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 15% of previous all income", parse("#template 15% of previous all income"), "{\"type\":\"percentage\",\"percent\":15,\"previous\":true,\"category\":\"all income\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 1500 repeat every 2 years starting 2025-01-01", parse("#template 1500 repeat every 2 years starting 2025-01-01"), "{\"type\":\"periodic\",\"amount\":1500,\"period\":{\"period\":\"year\",\"amount\":2},\"starting\":\"2025-01-01\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
