# Tests for goal_template.bend. Each check parses one template line; the
# expected text is `JSON.stringify` of what the Peggy parser generated from
# goal-template.pegjs answers, or `error` where it throws. The lines come
# from the TypeScript tests and the documentation, plus edge cases.
import Base
import ../lib/test.bend as T
import ../json/json.bend as J
import ./goal_template.bend as G

def parse(line: String) -> String:
  Maybe.default(&2, String, Maybe.map(&2, J.Json, String, j => J.Json.show(j), G.GoalTemplate.parse(line)), "error")

def part_0() -> List<&2, T.Test.Check>:
  [
    T.Check{"#goal", parse("#goal"), "error"},
    T.Check{"#goal 10", parse("#goal 10"), "{\"type\":\"goal\",\"amount\":10,\"priority\":null,\"directive\":\"goal\"}"},
    T.Check{"#goal 1000", parse("#goal 1000"), "{\"type\":\"goal\",\"amount\":1000,\"priority\":null,\"directive\":\"goal\"}"},
    T.Check{"#goal 1234", parse("#goal 1234"), "{\"type\":\"goal\",\"amount\":1234,\"priority\":null,\"directive\":\"goal\"}"},
    T.Check{"#goal 500", parse("#goal 500"), "{\"type\":\"goal\",\"amount\":500,\"priority\":null,\"directive\":\"goal\"}"},
    T.Check{"#template", parse("#template"), "error"},
    T.Check{"#template -100 by 2026-12", parse("#template -100 by 2026-12"), "error"},
    T.Check{"#template -100 by 2026-12 repeat every month", parse("#template -100 by 2026-12 repeat every month"), "error"},
    T.Check{"#template -100 by 2026-12 spend from 2026-10", parse("#template -100 by 2026-12 spend from 2026-10"), "error"},
    T.Check{"#template -100 repeat every 2 months starting 2026-01-01", parse("#template -100 repeat every 2 months starting 2026-01-01"), "{\"type\":\"periodic\",\"amount\":-100,\"period\":{\"period\":\"month\",\"amount\":2},\"starting\":\"2026-01-01\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template -103.23", parse("#template -103.23"), "{\"type\":\"simple\",\"monthly\":-103.23,\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 0", parse("#template 0"), "{\"type\":\"simple\",\"monthly\":0,\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 0 up to 200", parse("#template 0 up to 200"), "{\"type\":\"simple\",\"monthly\":0,\"limit\":{\"amount\":200,\"hold\":null,\"period\":\"monthly\",\"start\":null},\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10", parse("#template 10"), "{\"type\":\"simple\",\"monthly\":10,\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10 repeat every 2 weeks starting 2025-01-04", parse("#template 10 repeat every 2 weeks starting 2025-01-04"), "{\"type\":\"periodic\",\"amount\":10,\"period\":{\"period\":\"week\",\"amount\":2},\"starting\":\"2025-01-04\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10 repeat every day starting 2025-01-01", parse("#template 10 repeat every day starting 2025-01-01"), "{\"type\":\"periodic\",\"amount\":10,\"period\":{\"period\":\"day\",\"amount\":1},\"starting\":\"2025-01-01\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10 repeat every day starting 2025-01-01 up to 400", parse("#template 10 repeat every day starting 2025-01-01 up to 400"), "{\"type\":\"periodic\",\"amount\":10,\"period\":{\"period\":\"day\",\"amount\":1},\"starting\":\"2025-01-01\",\"limit\":{\"amount\":400,\"hold\":null,\"period\":\"monthly\",\"start\":null},\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10 repeat every week starting 2025-01-06", parse("#template 10 repeat every week starting 2025-01-06"), "{\"type\":\"periodic\",\"amount\":10,\"period\":{\"period\":\"week\",\"amount\":1},\"starting\":\"2025-01-06\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10 repeat every week starting 2025-01-06 up to 55", parse("#template 10 repeat every week starting 2025-01-06 up to 55"), "{\"type\":\"periodic\",\"amount\":10,\"period\":{\"period\":\"week\",\"amount\":1},\"starting\":\"2025-01-06\",\"limit\":{\"amount\":55,\"hold\":null,\"period\":\"monthly\",\"start\":null},\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10% of Paycheck", parse("#template 10% of Paycheck"), "{\"type\":\"percentage\",\"percent\":10,\"previous\":false,\"category\":\"Paycheck\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10% of all income", parse("#template 10% of all income"), "{\"type\":\"percentage\",\"percent\":10,\"previous\":false,\"category\":\"all income\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10% of available funds", parse("#template 10% of available funds"), "{\"type\":\"percentage\",\"percent\":10,\"previous\":false,\"category\":\"available funds\",\"priority\":0,\"directive\":\"template\"}"},
    T.Check{"#template 10% of previous Paycheck", parse("#template 10% of previous Paycheck"), "{\"type\":\"percentage\",\"percent\":10,\"previous\":true,\"category\":\"Paycheck\",\"priority\":0,\"directive\":\"template\"}"},
