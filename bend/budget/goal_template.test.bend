    T.Check{"#template 200 repeat every 2 months starting 2025-06-01", parse("#template 200 repeat every 2 months starting 2025-06-01"), "{\"type\":\"periodic\",\"amount\":200,\"period\":{\"period\":\"month\",\"amount\":2},\"starting\":\"2025-06-01\",\"limit\":null,\"priority\":0,\"directive\":\"template\"}"},
