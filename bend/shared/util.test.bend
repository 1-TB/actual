def part_10() -> List<&2, T.Test.Check>:
  [
    T.Check{"amountToInteger 12.3456 3", mint(F.Util.amount_to_integer(dec("12.3456"), 3n)), "12346"},
    T.Check{"amountToInteger 7 2", mint(F.Util.amount_to_integer(dec("7"), 2n)), "700"},
    T.Check{"integerToAmount 12345 2", N.Num.show(F.Util.integer_to_amount(int("12345"), 2n)), "123.45"},
    T.Check{"integerToAmount -12345 2", N.Num.show(F.Util.integer_to_amount(int("-12345"), 2n)), "-123.45"},
    T.Check{"integerToAmount 5 2", N.Num.show(F.Util.integer_to_amount(int("5"), 2n)), "0.05"},
    T.Check{"integerToAmount 0 2", N.Num.show(F.Util.integer_to_amount(int("0"), 2n)), "0"},
    T.Check{"integerToAmount 1500 0", N.Num.show(F.Util.integer_to_amount(int("1500"), 0n)), "1500"},
    T.Check{"integerToAmount 123456 3", N.Num.show(F.Util.integer_to_amount(int("123456"), 3n)), "123.456"},
    T.Check{"integerToAmount -7 1", N.Num.show(F.Util.integer_to_amount(int("-7"), 1n)), "-0.7"},
    T.Check{"parseNumberFormat comma-dot", F.Util.number_format_name(F.Util.parse_number_format("comma-dot")), "comma-dot"},
    T.Check{"parseNumberFormat dot-comma", F.Util.number_format_name(F.Util.parse_number_format("dot-comma")), "dot-comma"},
    T.Check{"parseNumberFormat space-comma", F.Util.number_format_name(F.Util.parse_number_format("space-comma")), "space-comma"},
    T.Check{"parseNumberFormat apostrophe-dot", F.Util.number_format_name(F.Util.parse_number_format("apostrophe-dot")), "apostrophe-dot"},
    T.Check{"parseNumberFormat comma-dot-in", F.Util.number_format_name(F.Util.parse_number_format("comma-dot-in")), "comma-dot-in"},
    T.Check{"parseNumberFormat bogus", F.Util.number_format_name(F.Util.parse_number_format("bogus")), "comma-dot"},
    T.Check{"parseNumberFormat ", F.Util.number_format_name(F.Util.parse_number_format("")), "comma-dot"} ]

# Where exact rounding differs from the TS float rounding (see util.bend).
def exact() -> List<&2, T.Test.Check>:
  [ T.Check{"1.005 is 101 cents, exactly", mint(F.Util.currency_to_integer("1.005", F.CommaDot{})), "101"} ]

def main() -> IO(Unit):
  T.Test.run(List.concat(&2, T.Test.Check, [exact(), part_0(), part_1(), part_2(), part_3(), part_4(), part_5(), part_6(), part_7(), part_8(), part_9(), part_10()]))
