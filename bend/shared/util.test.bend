# Tests for util.bend. Every expected value is what the TypeScript
# packages/loot-core/src/shared/util.ts answers for the same input (numbers
# as JS prints them, `null` for null and NaN), generated by running it, apart
# from `exact` below.
import Base
import ../lib/test.bend as T
import ../lib/int.bend as I
import ../lib/num.bend as N
import ./util.bend as F

def num(m: Maybe<&2, N.Num>) -> String:
  match m:
    case None{}:
      "null"
    case Some{a}:
      N.Num.show(a)

def mint(m: Maybe<&2, I.Int>) -> String:
  match m:
    case None{}:
      "null"
    case Some{i}:
      I.Int.show(i)

def int(s: String) -> I.Int:
  Maybe.default(&2, I.Int, I.Int.read(s), I.Int.zero())

def dec(s: String) -> N.Num:
  Maybe.default(&2, N.Num, F.Util.parse_float(s), N.Num.zero())

def part_0() -> List<&2, T.Test.Check>:
  [
    T.Check{"looselyParseAmount 3", num(F.Util.loosely_parse_amount("3")), "3"},
    T.Check{"looselyParseAmount 3.4", num(F.Util.loosely_parse_amount("3.4")), "3.4"},
