# Tests for tags.bend: the cases of packages/loot-core/src/shared/tags.test.ts
# and more, each expected value being what the TypeScript answers (lists and
# filters as `JSON.stringify` writes them), generated by running it.
import Base
import ../lib/test.bend as T
import ../json/json.bend as J
import ./tags.bend as G

def strings(xs: List<&2, String>) -> List<&2, J.Json>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{J.JStr{h}, strings(t)}

def show(xs: List<&2, String>) -> String:
  J.Json.show(J.Json.array(strings(xs)))

def main() -> IO(Unit):
  T.Test.run([
    T.Check{"extractTagsForFilter ", show(G.Tags.extract_for_filter("")), "[]"},
    T.Check{"extractTagsFromText ", show(G.Tags.extract_from_text("")), "[]"},
    T.Check{"extractTagsForFilter one #one ##one ##two three", show(G.Tags.extract_for_filter("one #one ##one ##two three")), "[\"#one\",\"#two\",\"#three\"]"},
    T.Check{"extractTagsFromText one #one ##one ##two three", show(G.Tags.extract_from_text("one #one ##one ##two three")), "[\"one\"]"},
    T.Check{"extractTagsForFilter #a#b", show(G.Tags.extract_for_filter("#a#b")), "[\"#a\",\"#b\"]"},
    T.Check{"extractTagsFromText #a#b", show(G.Tags.extract_from_text("#a#b")), "[\"a\",\"b\"]"},
    T.Check{"extractTagsForFilter ##one", show(G.Tags.extract_for_filter("##one")), "[\"#one\"]"},
    T.Check{"extractTagsFromText ##one", show(G.Tags.extract_from_text("##one")), "[]"},
    T.Check{"extractTagsForFilter ###a", show(G.Tags.extract_for_filter("###a")), "[\"#a\"]"},
    T.Check{"extractTagsFromText ###a", show(G.Tags.extract_from_text("###a")), "[]"},
    T.Check{"extractTagsForFilter #tag", show(G.Tags.extract_for_filter("#tag")), "[\"#tag\"]"},
    T.Check{"extractTagsFromText #tag", show(G.Tags.extract_from_text("#tag")), "[\"tag\"]"},
    T.Check{"extractTagsForFilter no tags here", show(G.Tags.extract_for_filter("no tags here")), "[\"#no\",\"#tags\",\"#here\"]"},
    T.Check{"extractTagsFromText no tags here", show(G.Tags.extract_from_text("no tags here")), "[]"},
    T.Check{"extractTagsForFilter #a #b #a", show(G.Tags.extract_for_filter("#a #b #a")), "[\"#a\",\"#b\"]"},
    T.Check{"extractTagsFromText #a #b #a", show(G.Tags.extract_from_text("#a #b #a")), "[\"a\",\"b\"]"},
    T.Check{"extractTagsForFilter x#y z", show(G.Tags.extract_for_filter("x#y z")), "[\"#x\",\"#y\",\"#z\"]"},
    T.Check{"extractTagsFromText x#y z", show(G.Tags.extract_from_text("x#y z")), "[\"y\"]"},
    T.Check{"extractTagsForFilter #", show(G.Tags.extract_for_filter("#")), "[]"},
    T.Check{"extractTagsFromText #", show(G.Tags.extract_from_text("#")), "[]"},
    T.Check{"extractTagsForFilter # #", show(G.Tags.extract_for_filter("# #")), "[]"},
    T.Check{"extractTagsFromText # #", show(G.Tags.extract_from_text("# #")), "[]"},
    T.Check{"extractTagsForFilter hello #world!", show(G.Tags.extract_for_filter("hello #world!")), "[\"#hello\",\"#world!\"]"},
    T.Check{"extractTagsFromText hello #world!", show(G.Tags.extract_from_text("hello #world!")), "[\"world!\"]"},
    T.Check{"extractTagsForFilter #one\t#two\n#three", show(G.Tags.extract_for_filter("#one\t#two\n#three")), "[\"#one\",\"#two\",\"#three\"]"},
    T.Check{"extractTagsFromText #one\t#two\n#three", show(G.Tags.extract_from_text("#one\t#two\n#three")), "[\"one\",\"two\",\"three\"]"},
    T.Check{"extractTagsForFilter a ##escaped #real", show(G.Tags.extract_for_filter("a ##escaped #real")), "[\"#a\",\"#escaped\",\"#real\"]"},
    T.Check{"extractTagsFromText a ##escaped #real", show(G.Tags.extract_from_text("a ##escaped #real")), "[\"real\"]"},
    T.Check{"extractTagsForFilter #a##b", show(G.Tags.extract_for_filter("#a##b")), "[\"#a\",\"#b\"]"},
    T.Check{"extractTagsFromText #a##b", show(G.Tags.extract_from_text("#a##b")), "[\"a\"]"},
    T.Check{"extractTagsForFilter end#", show(G.Tags.extract_for_filter("end#")), "[\"#end\"]"},
    T.Check{"extractTagsFromText end#", show(G.Tags.extract_from_text("end#")), "[]"},
    T.Check{"extractTagsForFilter #é #ünï", show(G.Tags.extract_for_filter("#é #ünï")), "[\"#é\",\"#ünï\"]"},
    T.Check{"extractTagsFromText #é #ünï", show(G.Tags.extract_from_text("#é #ünï")), "[\"é\",\"ünï\"]"},
    T.Check{"extractTagsForFilter #a #b", show(G.Tags.extract_for_filter("#a #b")), "[\"#a\",\"#b\"]"},
    T.Check{"extractTagsFromText #a #b", show(G.Tags.extract_from_text("#a #b")), "[\"a\",\"b\"]"},
    T.Check{"extractTagsForFilter #$5 #c++ #(x)", show(G.Tags.extract_for_filter("#$5 #c++ #(x)")), "[\"#$5\",\"#c++\",\"#(x)\"]"},
    T.Check{"extractTagsFromText #$5 #c++ #(x)", show(G.Tags.extract_from_text("#$5 #c++ #(x)")), "[\"$5\",\"c++\",\"(x)\"]"},
    T.Check{"renameTagInNotes #a #ab #a a->z", G.Tags.rename_in_notes("#a #ab #a", "a", "z"), "#z #ab #z"},
    T.Check{"renameTagInNotes ##a #a a->z", G.Tags.rename_in_notes("##a #a", "a", "z"), "##a #z"},
    T.Check{"renameTagInNotes #a#a a->b", G.Tags.rename_in_notes("#a#a", "a", "b"), "#b#b"},
    T.Check{"renameTagInNotes x #food. #food food->eat", G.Tags.rename_in_notes("x #food. #food", "food", "eat"), "x #food. #eat"},
    T.Check{"renameTagInNotes #food food->groceries", G.Tags.rename_in_notes("#food", "food", "groceries"), "#groceries"},
    T.Check{"renameTagInNotes #Food #food food->x", G.Tags.rename_in_notes("#Food #food", "food", "x"), "#Food #x"},
    T.Check{"renameTagInNotes #c++ #c+ c++->cpp", G.Tags.rename_in_notes("#c++ #c+", "c++", "cpp"), "#cpp #c+"},
    T.Check{"renameTagInNotes  a->b", G.Tags.rename_in_notes("", "a", "b"), ""},
    T.Check{"renameTagInNotes #a\t#a\n#a a->bb", G.Tags.rename_in_notes("#a\t#a\n#a", "a", "bb"), "#bb\t#bb\n#bb"},
    T.Check{"renameTagInNotes #aa a->b", G.Tags.rename_in_notes("#aa", "a", "b"), "#aa"},
    T.Check{"renameTagInNotes a#a a->b", G.Tags.rename_in_notes("a#a", "a", "b"), "a#b"},
    T.Check{"renameTagInNotes #a ##a ###a #a# a->q", G.Tags.rename_in_notes("#a ##a ###a #a#", "a", "q"), "#q ##a ###a #q#"},
    T.Check{"makeTagAqlRegex tag", G.Tags.aql_regex("tag"), "(^|[^#])#tag([\\s#]|$)"},
    T.Check{"makeTagAqlRegex #tag", G.Tags.aql_regex("#tag"), "(^|[^#])#tag([\\s#]|$)"},
    T.Check{"makeTagAqlRegex c++", G.Tags.aql_regex("c++"), "(^|[^#])#c\\+\\+([\\s#]|$)"},
    T.Check{"makeTagAqlRegex $5", G.Tags.aql_regex("$5"), "(^|[^#])#[$]5([\\s#]|$)"},
    T.Check{"makeTagAqlRegex a.b*c?d^e{f}g(h)i|j[k]l\\m", G.Tags.aql_regex("a.b*c?d^e{f}g(h)i|j[k]l\\m"), "(^|[^#])#a\\.b\\*c\\?d\\^e\\{f\\}g\\(h\\)i\\|j\\[k\\]l\\\\m([\\s#]|$)"},
    T.Check{"makeTagAqlRegex ", G.Tags.aql_regex(""), "(^|[^#])#([\\s#]|$)"},
    T.Check{"makeTagAqlRegex ##x", G.Tags.aql_regex("##x"), "(^|[^#])##x([\\s#]|$)"},
    T.Check{"makeExactTagSetQueryFilter a,b / a,b,c,d", J.Json.show(G.Tags.exact_set_filter(["a", "b"], ["a", "b", "c", "d"])), "{\"$and\":[{\"notes\":{\"$regexp\":\"(^|[^#])#a([\\\\s#]|$)\"}},{\"notes\":{\"$regexp\":\"(^|[^#])#b([\\\\s#]|$)\"}},{\"notes\":{\"$notregexp\":\"(^|[^#])#c([\\\\s#]|$)\"}},{\"notes\":{\"$notregexp\":\"(^|[^#])#d([\\\\s#]|$)\"}}]}"},
    T.Check{"makeExactTagSetQueryFilter  / x", J.Json.show(G.Tags.exact_set_filter([], ["x"])), "{\"$and\":[{\"notes\":{\"$notregexp\":\"(^|[^#])#x([\\\\s#]|$)\"}}]}"},
    T.Check{"makeExactTagSetQueryFilter a / ", J.Json.show(G.Tags.exact_set_filter(["a"], [])), "{\"$and\":[{\"notes\":{\"$regexp\":\"(^|[^#])#a([\\\\s#]|$)\"}}]}"},
    T.Check{"makeExactTagSetQueryFilter $x / $x,y.z", J.Json.show(G.Tags.exact_set_filter(["$x"], ["$x", "y.z"])), "{\"$and\":[{\"notes\":{\"$regexp\":\"(^|[^#])#[$]x([\\\\s#]|$)\"}},{\"notes\":{\"$notregexp\":\"(^|[^#])#y\\\\.z([\\\\s#]|$)\"}}]}"} ])
