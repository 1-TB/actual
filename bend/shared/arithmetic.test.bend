# Tests for arithmetic.bend: the cases of
# packages/loot-core/src/shared/arithmetic.test.ts and more, each expected
# value being what the TypeScript `evalArithmetic(expression)` answers (`null`
# for its default), generated by running it.
import Base
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./util.bend as F
import ./arithmetic.bend as A

def num(m: Maybe<&2, N.Num>) -> String:
  match m:
    case None{}:
      "null"
    case Some{a}:
      N.Num.show(a)

def cases() -> List<&2, T.Test.Check>:
  [
    T.Check{"comma-dot: -4", num(A.Arith.eval("-4", F.CommaDot{})), "-4"},
    T.Check{"comma-dot: 10 + -4", num(A.Arith.eval("10 + -4", F.CommaDot{})), "6"},
    T.Check{"comma-dot: 10 + 10", num(A.Arith.eval("10 + 10", F.CommaDot{})), "20"},
    T.Check{"comma-dot: 1.5 + 1.5", num(A.Arith.eval("1.5 + 1.5", F.CommaDot{})), "3"},
    T.Check{"comma-dot: (12 + 3) + (10)", num(A.Arith.eval("(12 + 3) + (10)", F.CommaDot{})), "25"},
    T.Check{"comma-dot: 10 + 20 + 30 + 40", num(A.Arith.eval("10 + 20 + 30 + 40", F.CommaDot{})), "100"},
    T.Check{"comma-dot: 10 - 10", num(A.Arith.eval("10 - 10", F.CommaDot{})), "0"},
    T.Check{"comma-dot: 4.5 - 1.5", num(A.Arith.eval("4.5 - 1.5", F.CommaDot{})), "3"},
    T.Check{"comma-dot: (12 - 3) - (10)", num(A.Arith.eval("(12 - 3) - (10)", F.CommaDot{})), "-1"},
    T.Check{"comma-dot: 10 - 20 - 30 - 40", num(A.Arith.eval("10 - 20 - 30 - 40", F.CommaDot{})), "-80"},
    T.Check{"comma-dot: 10 * 10", num(A.Arith.eval("10 * 10", F.CommaDot{})), "100"},
    T.Check{"comma-dot: 1.5 * 1.5", num(A.Arith.eval("1.5 * 1.5", F.CommaDot{})), "2.25"},
    T.Check{"comma-dot: 10 * 20 * 30 * 40", num(A.Arith.eval("10 * 20 * 30 * 40", F.CommaDot{})), "240000"},
    T.Check{"comma-dot: 10 / 10", num(A.Arith.eval("10 / 10", F.CommaDot{})), "1"},
    T.Check{"comma-dot: 1.5 / .5", num(A.Arith.eval("1.5 / .5", F.CommaDot{})), "3"},
    T.Check{"comma-dot: 2400 / 2 / 5", num(A.Arith.eval("2400 / 2 / 5", F.CommaDot{})), "240"},
    T.Check{"comma-dot: 1/0", num(A.Arith.eval("1/0", F.CommaDot{})), "null"},
    T.Check{"comma-dot: -1/0", num(A.Arith.eval("-1/0", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 0/0", num(A.Arith.eval("0/0", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 2^1024", num(A.Arith.eval("2^1024", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 12/2", num(A.Arith.eval("12/2", F.CommaDot{})), "6"},
    T.Check{"comma-dot: -12/2", num(A.Arith.eval("-12/2", F.CommaDot{})), "-6"},
    T.Check{"comma-dot: 0/2", num(A.Arith.eval("0/2", F.CommaDot{})), "0"},
    T.Check{"comma-dot: (5 + 3) * 10", num(A.Arith.eval("(5 + 3) * 10", F.CommaDot{})), "80"},
    T.Check{"comma-dot: 5 + 3 * 10", num(A.Arith.eval("5 + 3 * 10", F.CommaDot{})), "35"},
    T.Check{"comma-dot: 20^3 - 5 * (10 / 2)", num(A.Arith.eval("20^3 - 5 * (10 / 2)", F.CommaDot{})), "7975"},
    T.Check{"comma-dot: 2^3^2", num(A.Arith.eval("2^3^2", F.CommaDot{})), "512"},
    T.Check{"comma-dot: 24 / 3 * 2", num(A.Arith.eval("24 / 3 * 2", F.CommaDot{})), "16"},
    T.Check{"comma-dot: 24 * 3 / 2", num(A.Arith.eval("24 * 3 / 2", F.CommaDot{})), "36"},
    T.Check{"comma-dot: 10 - 2 + 1", num(A.Arith.eval("10 - 2 + 1", F.CommaDot{})), "9"},
    T.Check{"comma-dot: 10 + 2 - 1", num(A.Arith.eval("10 + 2 - 1", F.CommaDot{})), "11"},
    T.Check{"comma-dot: 1,222.45", num(A.Arith.eval("1,222.45", F.CommaDot{})), "1222.45"},
    T.Check{"comma-dot: 1+2)", num(A.Arith.eval("1+2)", F.CommaDot{})), "3"},
    T.Check{"comma-dot: 1+2)foo", num(A.Arith.eval("1+2)foo", F.CommaDot{})), "3"},
    T.Check{"comma-dot: (1+2)x", num(A.Arith.eval("(1+2)x", F.CommaDot{})), "3"},
    T.Check{"comma-dot: 10+20 trailing", num(A.Arith.eval("10+20 trailing", F.CommaDot{})), "30"},
    T.Check{"comma-dot: 1+2(3", num(A.Arith.eval("1+2(3", F.CommaDot{})), "3"},
    T.Check{"comma-dot: ", num(A.Arith.eval("", F.CommaDot{})), "null"},
    T.Check{"comma-dot: abc", num(A.Arith.eval("abc", F.CommaDot{})), "null"},
    T.Check{"comma-dot: (1+2", num(A.Arith.eval("(1+2", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 1+", num(A.Arith.eval("1+", F.CommaDot{})), "null"},
    T.Check{"comma-dot: *3", num(A.Arith.eval("*3", F.CommaDot{})), "null"},
    T.Check{"comma-dot: --4", num(A.Arith.eval("--4", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 2^-1", num(A.Arith.eval("2^-1", F.CommaDot{})), "0.5"},
    T.Check{"comma-dot: 2^0", num(A.Arith.eval("2^0", F.CommaDot{})), "1"},
    T.Check{"comma-dot: (1.5+2.5)*4", num(A.Arith.eval("(1.5+2.5)*4", F.CommaDot{})), "16"},
    T.Check{"comma-dot: $12.50 + €3", num(A.Arith.eval("$12.50 + €3", F.CommaDot{})), "15.5"},
    T.Check{"comma-dot: 10/4", num(A.Arith.eval("10/4", F.CommaDot{})), "2.5"},
    T.Check{"comma-dot: 1/8", num(A.Arith.eval("1/8", F.CommaDot{})), "0.125"},
    T.Check{"comma-dot: 3 * (2 + (4 - 1)) ^ 2", num(A.Arith.eval("3 * (2 + (4 - 1)) ^ 2", F.CommaDot{})), "75"},
    T.Check{"comma-dot: 7/2*2", num(A.Arith.eval("7/2*2", F.CommaDot{})), "7"},
    T.Check{"comma-dot: ((((5))))", num(A.Arith.eval("((((5))))", F.CommaDot{})), "5"},
    T.Check{"comma-dot: 1,000 + 2,000.50", num(A.Arith.eval("1,000 + 2,000.50", F.CommaDot{})), "3000.5"},
    T.Check{"comma-dot: -(3)", num(A.Arith.eval("-(3)", F.CommaDot{})), "null"},
    T.Check{"comma-dot: 5 - -5", num(A.Arith.eval("5 - -5", F.CommaDot{})), "10"},
    T.Check{"comma-dot: 2 ^ 10", num(A.Arith.eval("2 ^ 10", F.CommaDot{})), "1024"},
    T.Check{"comma-dot: 10 % 3", num(A.Arith.eval("10 % 3", F.CommaDot{})), "10"},
    T.Check{"space-comma: 1 222,45", num(A.Arith.eval("1 222,45", F.SpaceComma{})), "1222.45"},
    T.Check{"space-comma: 1 222,45 + 1", num(A.Arith.eval("1 222,45 + 1", F.SpaceComma{})), "1223.45"},
    T.Check{"space-comma: 3,5 * 2", num(A.Arith.eval("3,5 * 2", F.SpaceComma{})), "7"},
    T.Check{"dot-comma: 1.222,45", num(A.Arith.eval("1.222,45", F.DotComma{})), "1222.45"},
    T.Check{"dot-comma: 1.000 + 1", num(A.Arith.eval("1.000 + 1", F.DotComma{})), "1001"},
    T.Check{"dot-comma: 3,5 * 2", num(A.Arith.eval("3,5 * 2", F.DotComma{})), "7"},
    T.Check{"apostrophe-dot: 1’222.45", num(A.Arith.eval("1’222.45", F.ApostropheDot{})), "1222.45"},
    T.Check{"apostrophe-dot: 12'345.67", num(A.Arith.eval("12'345.67", F.ApostropheDot{})), "12345.67"},
    T.Check{"apostrophe-dot: 1'234.56", num(A.Arith.eval("1'234.56", F.ApostropheDot{})), "1234.56"},
    T.Check{"apostrophe-dot: 1'000.33", num(A.Arith.eval("1'000.33", F.ApostropheDot{})), "1000.33"},
    T.Check{"apostrophe-dot: 100'000.99", num(A.Arith.eval("100'000.99", F.ApostropheDot{})), "100000.99"},
    T.Check{"apostrophe-dot: 1'000'000.50", num(A.Arith.eval("1'000'000.50", F.ApostropheDot{})), "1000000.5"},
    T.Check{"apostrophe-dot: 12’345.67", num(A.Arith.eval("12’345.67", F.ApostropheDot{})), "12345.67"},
    T.Check{"apostrophe-dot: 1'000 + 2'000", num(A.Arith.eval("1'000 + 2'000", F.ApostropheDot{})), "3000"},
    T.Check{"apostrophe-dot: 10'000 - 2'500", num(A.Arith.eval("10'000 - 2'500", F.ApostropheDot{})), "7500"},
    T.Check{"apostrophe-dot: 1'000 * 2", num(A.Arith.eval("1'000 * 2", F.ApostropheDot{})), "2000"},
    T.Check{"apostrophe-dot: 4'000 / 2", num(A.Arith.eval("4'000 / 2", F.ApostropheDot{})), "2000"},
    T.Check{"apostrophe-dot: 1’000 + 2’000", num(A.Arith.eval("1’000 + 2’000", F.ApostropheDot{})), "3000"},
    T.Check{"comma-dot-in: 1,00,000.99 + 1", num(A.Arith.eval("1,00,000.99 + 1", F.CommaDotIn{})), "100001.99"} ]

# Where the exact evaluator and the TS float evaluator part ways.
def exact() -> List<&2, T.Test.Check>:
  [ T.Check{"a fractional exponent is refused", num(A.Arith.eval("(-1)^.5", F.CommaDot{})), "null"},
    T.Check{"a square root is refused too", num(A.Arith.eval("4^.5", F.CommaDot{})), "null"},
    T.Check{"no float error: the TS answers 0.010000000000005116",
      num(A.Arith.eval("100 - 99.99", F.CommaDot{})), "0.01"},
    T.Check{"no float error: the TS answers 5.551115123125783e-17",
      num(A.Arith.eval("0.1 + 0.2 - 0.3", F.CommaDot{})), "0"},
    T.Check{"a third stays a third", num(A.Arith.eval("1/3", F.CommaDot{})), "1/3"},
    T.Check{"and times three is one", num(A.Arith.eval("1/3*3", F.CommaDot{})), "1"} ]

def main() -> IO(Unit):
  T.Test.run(List.concat(&2, T.Test.Check, [cases(), exact()]))
