    T.Check{"getCurrency SEK", desc(K.Currencies.get("SEK")), "SEK|kr|Swedish Krona|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces SEK", K.Currencies.decimal_places("SEK"), 2n),
    T.Check{"getCurrency SGD", desc(K.Currencies.get("SGD")), "SGD|S$|Singapore Dollar|2|comma-dot|true"},
