    T.Test.nat("getDecimalPlaces THB", K.Currencies.decimal_places("THB"), 2n),
    T.Check{"getCurrency TRY", desc(K.Currencies.get("TRY")), "TRY|₺|Turkish Lira|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces TRY", K.Currencies.decimal_places("TRY"), 2n),
    T.Check{"getCurrency TWD", desc(K.Currencies.get("TWD")), "TWD|NT$|New Taiwan Dollar|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces TWD", K.Currencies.decimal_places("TWD"), 2n),
    T.Check{"getCurrency TZS", desc(K.Currencies.get("TZS")), "TZS|TSh|Tanzanian Shilling|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces TZS", K.Currencies.decimal_places("TZS"), 2n),
    T.Check{"getCurrency UAH", desc(K.Currencies.get("UAH")), "UAH|₴|Ukrainian Hryvnia|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces UAH", K.Currencies.decimal_places("UAH"), 2n),
    T.Check{"getCurrency USD", desc(K.Currencies.get("USD")), "USD|$|US Dollar|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces USD", K.Currencies.decimal_places("USD"), 2n),
    T.Check{"getCurrency UYU", desc(K.Currencies.get("UYU")), "UYU|$U|Uruguayan Peso|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces UYU", K.Currencies.decimal_places("UYU"), 2n),
    T.Check{"getCurrency UZS", desc(K.Currencies.get("UZS")), "UZS|UZS|Uzbek Soum|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces UZS", K.Currencies.decimal_places("UZS"), 2n),
    T.Check{"getCurrency ZAR", desc(K.Currencies.get("ZAR")), "ZAR|R|South African Rand|2|space-comma|true"},
    T.Test.nat("getDecimalPlaces ZAR", K.Currencies.decimal_places("ZAR"), 2n),
    T.Check{"getCurrency XXX", desc(K.Currencies.get("XXX")), "||None|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces XXX", K.Currencies.decimal_places("XXX"), 2n),
    T.Check{"getCurrency usd", desc(K.Currencies.get("usd")), "||None|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces usd", K.Currencies.decimal_places("usd"), 2n),
    T.Check{"integerToCurrencyWithDecimal 0 USD", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, "USD"), "0.00"},
    T.Check{"integerToCurrencyWithDecimal 12345 USD", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, "USD"), "123.45"},
    T.Check{"integerToCurrencyWithDecimal -12345 USD", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, "USD"), "-123.45"},
    T.Check{"integerToCurrencyWithDecimal 150 USD", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, "USD"), "1.50"},
    T.Check{"integerToCurrencyWithDecimal 149 USD", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, "USD"), "1.49"},
    T.Check{"integerToCurrencyWithDecimal -150 USD", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, "USD"), "-1.50"},
    T.Check{"integerToCurrencyWithDecimal 100000000 USD", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, "USD"), "1,000,000.00"},
    T.Check{"integerToCurrencyWithDecimal 5 USD", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, "USD"), "0.05"},
    T.Check{"integerToCurrencyWithDecimal 0 JPY", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, "JPY"), "0"},
    T.Check{"integerToCurrencyWithDecimal 12345 JPY", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, "JPY"), "123"},
    T.Check{"integerToCurrencyWithDecimal -12345 JPY", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, "JPY"), "-123"},
    T.Check{"integerToCurrencyWithDecimal 150 JPY", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, "JPY"), "2"},
    T.Check{"integerToCurrencyWithDecimal 149 JPY", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, "JPY"), "1"},
    T.Check{"integerToCurrencyWithDecimal -150 JPY", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, "JPY"), "-2"},
    T.Check{"integerToCurrencyWithDecimal 100000000 JPY", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, "JPY"), "1,000,000"},
    T.Check{"integerToCurrencyWithDecimal 5 JPY", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, "JPY"), "0"},
    T.Check{"integerToCurrencyWithDecimal 0 IRR", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, "IRR"), "0"},
    T.Check{"integerToCurrencyWithDecimal 12345 IRR", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, "IRR"), "123"},
    T.Check{"integerToCurrencyWithDecimal -12345 IRR", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, "IRR"), "-123"},
    T.Check{"integerToCurrencyWithDecimal 150 IRR", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, "IRR"), "2"},
    T.Check{"integerToCurrencyWithDecimal 149 IRR", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, "IRR"), "1"},
    T.Check{"integerToCurrencyWithDecimal -150 IRR", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, "IRR"), "-2"},
    T.Check{"integerToCurrencyWithDecimal 100000000 IRR", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, "IRR"), "1,000,000"},
    T.Check{"integerToCurrencyWithDecimal 5 IRR", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, "IRR"), "0"},
    T.Check{"integerToCurrencyWithDecimal 0 EUR", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, "EUR"), "0.00"},
    T.Check{"integerToCurrencyWithDecimal 12345 EUR", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, "EUR"), "123.45"},
    T.Check{"integerToCurrencyWithDecimal -12345 EUR", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, "EUR"), "-123.45"},
    T.Check{"integerToCurrencyWithDecimal 150 EUR", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, "EUR"), "1.50"},
    T.Check{"integerToCurrencyWithDecimal 149 EUR", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, "EUR"), "1.49"},
    T.Check{"integerToCurrencyWithDecimal -150 EUR", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, "EUR"), "-1.50"},
    T.Check{"integerToCurrencyWithDecimal 100000000 EUR", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, "EUR"), "1,000,000.00"},
    T.Check{"integerToCurrencyWithDecimal 5 EUR", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, "EUR"), "0.05"},
    T.Check{"integerToCurrencyWithDecimal 0 ", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, ""), "0.00"},
    T.Check{"integerToCurrencyWithDecimal 12345 ", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, ""), "123.45"},
    T.Check{"integerToCurrencyWithDecimal -12345 ", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, ""), "-123.45"},
    T.Check{"integerToCurrencyWithDecimal 150 ", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, ""), "1.50"},
    T.Check{"integerToCurrencyWithDecimal 149 ", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, ""), "1.49"},
    T.Check{"integerToCurrencyWithDecimal -150 ", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, ""), "-1.50"},
    T.Check{"integerToCurrencyWithDecimal 100000000 ", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, ""), "1,000,000.00"},
    T.Check{"integerToCurrencyWithDecimal 5 ", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, ""), "0.05"},
    T.Check{"integerToCurrencyWithDecimal 0 XXX", K.Currencies.integer_to_currency(int("0"), F.CommaDot{}, "XXX"), "0.00"},
    T.Check{"integerToCurrencyWithDecimal 12345 XXX", K.Currencies.integer_to_currency(int("12345"), F.CommaDot{}, "XXX"), "123.45"},
    T.Check{"integerToCurrencyWithDecimal -12345 XXX", K.Currencies.integer_to_currency(int("-12345"), F.CommaDot{}, "XXX"), "-123.45"},
    T.Check{"integerToCurrencyWithDecimal 150 XXX", K.Currencies.integer_to_currency(int("150"), F.CommaDot{}, "XXX"), "1.50"},
    T.Check{"integerToCurrencyWithDecimal 149 XXX", K.Currencies.integer_to_currency(int("149"), F.CommaDot{}, "XXX"), "1.49"},
    T.Check{"integerToCurrencyWithDecimal -150 XXX", K.Currencies.integer_to_currency(int("-150"), F.CommaDot{}, "XXX"), "-1.50"},
    T.Check{"integerToCurrencyWithDecimal 100000000 XXX", K.Currencies.integer_to_currency(int("100000000"), F.CommaDot{}, "XXX"), "1,000,000.00"},
    T.Check{"integerToCurrencyWithDecimal 5 XXX", K.Currencies.integer_to_currency(int("5"), F.CommaDot{}, "XXX"), "0.05"} ])
