    T.Check{"getCurrency RUB", desc(K.Currencies.get("RUB")), "RUB|₽|Russian Ruble|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces RUB", K.Currencies.decimal_places("RUB"), 2n),
    T.Check{"getCurrency SAR", desc(K.Currencies.get("SAR")), "SAR|ر.س|Saudi Riyal|2|comma-dot|false"},
