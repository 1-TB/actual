# Tests for currencies.bend, each expected value being what the TypeScript
# answers, generated by running it.
import Base
import ../lib/test.bend as T
import ../lib/int.bend as I
import ./util.bend as F
import ./currencies.bend as K

def int(s: String) -> I.Int:
  Maybe.default(&2, I.Int, I.Int.read(s), I.Int.zero())

def desc(c: K.Currency) -> String:
  match c:
    case K.Currency{code, symbol, name, places, format, first}:
      code ++ "|" ++ symbol ++ "|" ++ name ++ "|" ++ Nat.show(places) ++ "|" ++
        F.Util.number_format_name(format) ++ "|" ++ Bool.pick(String, first, "true", "false")

def main() -> IO(Unit):
  T.Test.run([
    T.Check{"getCurrency ", desc(K.Currencies.get("")), "||None|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces ", K.Currencies.decimal_places(""), 2n),
    T.Check{"getCurrency AED", desc(K.Currencies.get("AED")), "AED|د.إ|UAE Dirham|2|comma-dot|false"},
    T.Test.nat("getDecimalPlaces AED", K.Currencies.decimal_places("AED"), 2n),
    T.Check{"getCurrency ARS", desc(K.Currencies.get("ARS")), "ARS|Arg$|Argentinian Peso|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces ARS", K.Currencies.decimal_places("ARS"), 2n),
    T.Check{"getCurrency AUD", desc(K.Currencies.get("AUD")), "AUD|A$|Australian Dollar|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces AUD", K.Currencies.decimal_places("AUD"), 2n),
    T.Check{"getCurrency BDT", desc(K.Currencies.get("BDT")), "BDT|৳|Bangladeshi Taka|2|comma-dot-in|true"},
    T.Test.nat("getDecimalPlaces BDT", K.Currencies.decimal_places("BDT"), 2n),
    T.Check{"getCurrency BRL", desc(K.Currencies.get("BRL")), "BRL|R$|Brazilian Real|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces BRL", K.Currencies.decimal_places("BRL"), 2n),
    T.Check{"getCurrency BYN", desc(K.Currencies.get("BYN")), "BYN|Br|Belarusian Ruble|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces BYN", K.Currencies.decimal_places("BYN"), 2n),
    T.Check{"getCurrency CAD", desc(K.Currencies.get("CAD")), "CAD|CA$|Canadian Dollar|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces CAD", K.Currencies.decimal_places("CAD"), 2n),
    T.Check{"getCurrency CHF", desc(K.Currencies.get("CHF")), "CHF|CHF|Swiss Franc|2|apostrophe-dot|true"},
    T.Test.nat("getDecimalPlaces CHF", K.Currencies.decimal_places("CHF"), 2n),
    T.Check{"getCurrency CLP", desc(K.Currencies.get("CLP")), "CLP|CLP$|Chilean Peso|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces CLP", K.Currencies.decimal_places("CLP"), 2n),
    T.Check{"getCurrency CNY", desc(K.Currencies.get("CNY")), "CNY|¥|Yuan Renminbi|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces CNY", K.Currencies.decimal_places("CNY"), 2n),
    T.Check{"getCurrency COP", desc(K.Currencies.get("COP")), "COP|Col$|Colombian Peso|2|dot-comma|true"},
    T.Test.nat("getDecimalPlaces COP", K.Currencies.decimal_places("COP"), 2n),
    T.Check{"getCurrency CRC", desc(K.Currencies.get("CRC")), "CRC|₡|Costa Rican Colón|2|space-comma|true"},
    T.Test.nat("getDecimalPlaces CRC", K.Currencies.decimal_places("CRC"), 2n),
    T.Check{"getCurrency CZK", desc(K.Currencies.get("CZK")), "CZK|Kč|Czech Koruna|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces CZK", K.Currencies.decimal_places("CZK"), 2n),
