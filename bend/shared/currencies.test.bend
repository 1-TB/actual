    T.Test.nat("getDecimalPlaces ILS", K.Currencies.decimal_places("ILS"), 2n),
    T.Check{"getCurrency INR", desc(K.Currencies.get("INR")), "INR|₹|Indian Rupee|2|comma-dot-in|true"},
    T.Test.nat("getDecimalPlaces INR", K.Currencies.decimal_places("INR"), 2n),
    T.Check{"getCurrency IRR", desc(K.Currencies.get("IRR")), "IRR|﷼|Iranian Rial|0|comma-dot|false"},
    T.Test.nat("getDecimalPlaces IRR", K.Currencies.decimal_places("IRR"), 0n),
    T.Check{"getCurrency JMD", desc(K.Currencies.get("JMD")), "JMD|J$|Jamaican Dollar|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces JMD", K.Currencies.decimal_places("JMD"), 2n),
    T.Check{"getCurrency JPY", desc(K.Currencies.get("JPY")), "JPY|¥|Japanese Yen|0|comma-dot|true"},
