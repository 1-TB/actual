    T.Check{"getCurrency PKR", desc(K.Currencies.get("PKR")), "PKR|Rs.|Pakistani Rupee|2|comma-dot|true"},
    T.Test.nat("getDecimalPlaces PKR", K.Currencies.decimal_places("PKR"), 2n),
    T.Check{"getCurrency PLN", desc(K.Currencies.get("PLN")), "PLN|zł|Polish Złoty|2|space-comma|false"},
    T.Test.nat("getDecimalPlaces PLN", K.Currencies.decimal_places("PLN"), 2n),
    T.Check{"getCurrency QAR", desc(K.Currencies.get("QAR")), "QAR|ر.ق|Qatari Riyal|2|comma-dot|false"},
    T.Test.nat("getDecimalPlaces QAR", K.Currencies.decimal_places("QAR"), 2n),
    T.Check{"getCurrency RON", desc(K.Currencies.get("RON")), "RON|lei|Romanian Leu|2|dot-comma|false"},
    T.Test.nat("getDecimalPlaces RON", K.Currencies.decimal_places("RON"), 2n),
    T.Check{"getCurrency RSD", desc(K.Currencies.get("RSD")), "RSD|дин|Serbian Dinar|2|dot-comma|false"},
