    T.Check{"getCurrency EUR", desc(K.Currencies.get("EUR")), "EUR|€|Euro|2|dot-comma|false"},
    T.Test.nat("getDecimalPlaces EUR", K.Currencies.decimal_places("EUR"), 2n),
    T.Check{"getCurrency GBP", desc(K.Currencies.get("GBP")), "GBP|£|Pound Sterling|2|comma-dot|true"},
