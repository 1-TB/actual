def checks_parse_1() -> List<&2, T.Test.Check>:
  [ T.Check{"yearFromDate(\"2020\")", str(M.Months.year_from_date("2020")), "2020"},
    T.Check{"monthFromDate(\"2020\")", str(M.Months.month_from_date("2020")), "2020-01"},
    T.Check{"dayFromDate(\"2020\")", str(M.Months.day_from_date("2020")), "2020-01-01"},
    T.Check{"yearFromDate(\"2020-06\")", str(M.Months.year_from_date("2020-06")), "2020"},
    T.Check{"monthFromDate(\"2020-06\")", str(M.Months.month_from_date("2020-06")), "2020-06"},
    T.Check{"dayFromDate(\"2020-06\")", str(M.Months.day_from_date("2020-06")), "2020-06-01"},
    T.Check{"yearFromDate(\"2020-06-15\")", str(M.Months.year_from_date("2020-06-15")), "2020"},
    T.Check{"monthFromDate(\"2020-06-15\")", str(M.Months.month_from_date("2020-06-15")), "2020-06"},
    T.Check{"dayFromDate(\"2020-06-15\")", str(M.Months.day_from_date("2020-06-15")), "2020-06-15"},
    T.Check{"yearFromDate(\"2020-13\")", str(M.Months.year_from_date("2020-13")), "2021"},
    T.Check{"monthFromDate(\"2020-13\")", str(M.Months.month_from_date("2020-13")), "2021-01"},
    T.Check{"dayFromDate(\"2020-13\")", str(M.Months.day_from_date("2020-13")), "2021-01-01"},
    T.Check{"yearFromDate(\"2020-00\")", str(M.Months.year_from_date("2020-00")), "2019"},
    T.Check{"monthFromDate(\"2020-00\")", str(M.Months.month_from_date("2020-00")), "2019-12"},
    T.Check{"dayFromDate(\"2020-00\")", str(M.Months.day_from_date("2020-00")), "2019-12-01"},
    T.Check{"yearFromDate(\"2020-02-30\")", str(M.Months.year_from_date("2020-02-30")), "2020"},
    T.Check{"monthFromDate(\"2020-02-30\")", str(M.Months.month_from_date("2020-02-30")), "2020-03"},
    T.Check{"dayFromDate(\"2020-02-30\")", str(M.Months.day_from_date("2020-02-30")), "2020-03-01"},
    T.Check{"yearFromDate(\"2020-01-00\")", str(M.Months.year_from_date("2020-01-00")), "2019"},
    T.Check{"monthFromDate(\"2020-01-00\")", str(M.Months.month_from_date("2020-01-00")), "2019-12"},
    T.Check{"dayFromDate(\"2020-01-00\")", str(M.Months.day_from_date("2020-01-00")), "2019-12-31"},
    T.Check{"yearFromDate(\"2020-1-5\")", str(M.Months.year_from_date("2020-1-5")), "2020"},
    T.Check{"monthFromDate(\"2020-1-5\")", str(M.Months.month_from_date("2020-1-5")), "2020-01"},
    T.Check{"dayFromDate(\"2020-1-5\")", str(M.Months.day_from_date("2020-1-5")), "2020-01-05"},
    T.Check{"yearFromDate(\" 2020-03-04\")", str(M.Months.year_from_date(" 2020-03-04")), "2020"},
    T.Check{"monthFromDate(\" 2020-03-04\")", str(M.Months.month_from_date(" 2020-03-04")), "2020-03"},
    T.Check{"dayFromDate(\" 2020-03-04\")", str(M.Months.day_from_date(" 2020-03-04")), "2020-03-04"},
    T.Check{"yearFromDate(\"2020-03-04T10:20:30\")", str(M.Months.year_from_date("2020-03-04T10:20:30")), "2020"},
    T.Check{"monthFromDate(\"2020-03-04T10:20:30\")", str(M.Months.month_from_date("2020-03-04T10:20:30")), "2020-03"},
    T.Check{"dayFromDate(\"2020-03-04T10:20:30\")", str(M.Months.day_from_date("2020-03-04T10:20:30")), "2020-03-04"},
    T.Check{"yearFromDate(\"2020-12-31-99\")", str(M.Months.year_from_date("2020-12-31-99")), "2020"},
    T.Check{"monthFromDate(\"2020-12-31-99\")", str(M.Months.month_from_date("2020-12-31-99")), "2020-12"},
    T.Check{"dayFromDate(\"2020-12-31-99\")", str(M.Months.day_from_date("2020-12-31-99")), "2020-12-31"},
    T.Check{"yearFromDate(\"1970-01-01\")", str(M.Months.year_from_date("1970-01-01")), "1970"},
    T.Check{"monthFromDate(\"1970-01-01\")", str(M.Months.month_from_date("1970-01-01")), "1970-01"},
    T.Check{"dayFromDate(\"1970-01-01\")", str(M.Months.day_from_date("1970-01-01")), "1970-01-01"},
    T.Check{"yearFromDate(\"9999-12-31\")", str(M.Months.year_from_date("9999-12-31")), "9999"},
    T.Check{"monthFromDate(\"9999-12-31\")", str(M.Months.month_from_date("9999-12-31")), "9999-12"},
    T.Check{"dayFromDate(\"9999-12-31\")", str(M.Months.day_from_date("9999-12-31")), "9999-12-31"},
    T.Check{"yearFromDate(\"12345-06-07\")", str(M.Months.year_from_date("12345-06-07")), "12345"} ]

def checks_parse_2() -> List<&2, T.Test.Check>:
  [ T.Check{"monthFromDate(\"12345-06-07\")", str(M.Months.month_from_date("12345-06-07")), "12345-06"},
    T.Check{"dayFromDate(\"12345-06-07\")", str(M.Months.day_from_date("12345-06-07")), "12345-06-07"},
    T.Check{"yearFromDate(\"\")", str(M.Months.year_from_date("")), "throws"},
    T.Check{"monthFromDate(\"\")", str(M.Months.month_from_date("")), "throws"},
    T.Check{"dayFromDate(\"\")", str(M.Months.day_from_date("")), "throws"},
