  [ T.Check{"differenceInCalendarMonths(\"2024-01\", \"2024-03\")", int(M.Months.difference_in_calendar_months("2024-01", "2024-03")), "-2"},
    T.Check{"differenceInCalendarDays(\"2024-01\", \"2024-03\")", int(M.Months.difference_in_calendar_days("2024-01", "2024-03")), "-60"},
    T.Check{"isBefore(\"2024-01\", \"2024-03\")", Bool.show(M.Months.is_before("2024-01", "2024-03")), "True"},
    T.Check{"isAfter(\"2024-01\", \"2024-03\")", Bool.show(M.Months.is_after("2024-01", "2024-03")), "False"},
    T.Check{"differenceInCalendarMonths(\"2024-03\", \"2024-01\")", int(M.Months.difference_in_calendar_months("2024-03", "2024-01")), "2"},
    T.Check{"differenceInCalendarDays(\"2024-03\", \"2024-01\")", int(M.Months.difference_in_calendar_days("2024-03", "2024-01")), "60"},
    T.Check{"isBefore(\"2024-03\", \"2024-01\")", Bool.show(M.Months.is_before("2024-03", "2024-01")), "False"},
