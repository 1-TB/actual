# The cases of packages/loot-core/src/shared/months.test.ts (group `ported`)
# and further cases for every exported function. The expected values were
# produced by running the original TypeScript (date-fns 4) with a generator
# script, under TZ=UTC (which only the clock cases depend on); "throws" marks a call the original throws on, and NaN
# a NaN result.
import Base
import ../lib/test.bend as T
import ../lib/int.bend as I
import ./months.bend as M

def str(m: Maybe<&2, String>) -> String:
  Maybe.default(&2, String, m, "throws")

def int.show(i: I.Int) -> String:
  I.Int.show(i)

def int(m: Maybe<&2, I.Int>) -> String:
  Maybe.default(&2, String, Maybe.map(&2, I.Int, String, int.show, m), "NaN")

def nat(m: Maybe<&2, Nat>) -> String:
  Maybe.default(&2, String, Maybe.map(&2, Nat, String, Nat.show, m), "NaN")

def nat.or_throws(m: Maybe<&2, Nat>) -> String:
  Maybe.default(&2, String, Maybe.map(&2, Nat, String, Nat.show, m), "throws")

def list.show(xs: List<&2, String>) -> String:
  "[" ++ String.join(xs, ",") ++ "]"

def list(m: Maybe<&2, List<&2, String>>) -> String:
  Maybe.default(&2, String, Maybe.map(&2, List<&2, String>, String, list.show, m), "throws")

def bounds.show(b: M.Months.Bounds) -> String:
  match b:
    case M.Bounds{start, end}:
      Nat.show(start) ++ "," ++ Nat.show(end)

def bounds(m: Maybe<&2, M.Months.Bounds>) -> String:
  Maybe.default(&2, String, Maybe.map(&2, M.Months.Bounds, String, bounds.show, m), "throws")

def checks_ported_1() -> List<&2, T.Test.Check>:
  [ T.Check{"range(\"2016-10\", \"2018-01\")", list(M.Months.range("2016-10", "2018-01")), "[2016-10,2016-11,2016-12,2017-01,2017-02,2017-03,2017-04,2017-05,2017-06,2017-07,2017-08,2017-09,2017-10,2017-11,2017-12]"},
    T.Check{"getQuarter(\"2024-01\")", nat(M.Months.get_quarter("2024-01")), "1"},
    T.Check{"getQuarter(\"2024-03\")", nat(M.Months.get_quarter("2024-03")), "1"},
    T.Check{"getQuarter(\"2024-04\")", nat(M.Months.get_quarter("2024-04")), "2"},
    T.Check{"getQuarter(\"2024-06\")", nat(M.Months.get_quarter("2024-06")), "2"},
    T.Check{"getQuarter(\"2024-07\")", nat(M.Months.get_quarter("2024-07")), "3"},
    T.Check{"getQuarter(\"2024-09\")", nat(M.Months.get_quarter("2024-09")), "3"},
    T.Check{"getQuarter(\"2024-10\")", nat(M.Months.get_quarter("2024-10")), "4"},
    T.Check{"getQuarter(\"2024-12\")", nat(M.Months.get_quarter("2024-12")), "4"},
    T.Check{"getQuarterStart(\"2024-02\")", M.Months.get_quarter_start("2024-02"), "2024-01"},
    T.Check{"getQuarterEnd(\"2024-02\")", M.Months.get_quarter_end("2024-02"), "2024-03"},
    T.Check{"getQuarterStart(\"2024-11\")", M.Months.get_quarter_start("2024-11"), "2024-10"},
    T.Check{"getQuarterEnd(\"2024-11\")", M.Months.get_quarter_end("2024-11"), "2024-12"},
    T.Check{"quarterFromDate(\"2024-01-01\")", str(M.Months.quarter_from_date("2024-01-01")), "2024-01"},
    T.Check{"quarterFromDate(\"2024-03-31\")", str(M.Months.quarter_from_date("2024-03-31")), "2024-01"},
    T.Check{"quarterFromDate(\"2024-05\")", str(M.Months.quarter_from_date("2024-05")), "2024-04"},
    T.Check{"quarterFromDate(\"2024-12-15\")", str(M.Months.quarter_from_date("2024-12-15")), "2024-10"},
    T.Check{"quarterRangeInclusive(\"2023-11-15\", \"2024-05-01\")", list(M.Months.quarter_range_inclusive("2023-11-15", "2024-05-01")), "[2023-10,2024-01,2024-04]"},
    T.Check{"quarterRangeInclusive(\"2024-02\", \"2024-03\")", list(M.Months.quarter_range_inclusive("2024-02", "2024-03")), "[2024-01]"},
    T.Check{"prevQuarter(\"2024-02\", \"yyyy-MM\")", str(M.Months.prev_quarter("2024-02", "yyyy-MM")), "2023-11"},
    T.Check{"prevQuarter(\"2024-01\", \"yyyy-MM\")", str(M.Months.prev_quarter("2024-01", "yyyy-MM")), "2023-10"},
    T.Check{"prevQuarter(\"2024-04\", \"yyyy-MM\")", str(M.Months.prev_quarter("2024-04", "yyyy-MM")), "2024-01"},
    T.Check{"isValidYearMonthDay(\"2024-02-29\")", Bool.show(M.Months.is_valid_year_month_day("2024-02-29")), "True"},
    T.Check{"isValidYearMonthDay(\"2023-02-29\")", Bool.show(M.Months.is_valid_year_month_day("2023-02-29")), "False"},
    T.Check{"isValidYearMonthDay(\"2024-04-31\")", Bool.show(M.Months.is_valid_year_month_day("2024-04-31")), "False"},
    T.Check{"isValidYearMonthDay(\"2024-12-31\")", Bool.show(M.Months.is_valid_year_month_day("2024-12-31")), "True"},
    T.Check{"isValidYearMonthDay(\"2024-00-10\")", Bool.show(M.Months.is_valid_year_month_day("2024-00-10")), "False"},
    T.Check{"isValidYearMonthDay(\"2024-13-10\")", Bool.show(M.Months.is_valid_year_month_day("2024-13-10")), "False"},
    T.Check{"isValidYearMonthDay(\"2024-02-00\")", Bool.show(M.Months.is_valid_year_month_day("2024-02-00")), "False"},
    T.Check{"isValidYearMonthDay(\"2024-02\")", Bool.show(M.Months.is_valid_year_month_day("2024-02")), "False"},
    T.Check{"currentMonth @1483272000000", M.Months.current_month((1483272n * 1000000n + 0n : Nat)), "2017-01"},
    T.Check{"currentYear @1483272000000", M.Months.current_year((1483272n * 1000000n + 0n : Nat)), "2017"},
    T.Check{"currentDay @1483272000000", M.Months.current_day((1483272n * 1000000n + 0n : Nat)), "2017-01-01"},
    T.Check{"currentDate @1483272000000", M.Months.fmt_day(M.Months.current_date((1483272n * 1000000n + 0n : Nat))), "2017-01-01"},
    T.Check{"currentQuarter @1483272000000", M.Months.current_quarter((1483272n * 1000000n + 0n : Nat)), "2017-01"},
    T.Check{"currentWeek(0) @1483272000000", str(M.Months.current_week((1483272n * 1000000n + 0n : Nat), 0n)), "2017-01-01"},
    T.Check{"currentWeek(1) @1483272000000", str(M.Months.current_week((1483272n * 1000000n + 0n : Nat), 1n)), "2016-12-26"},
    T.Check{"currentWeek(6) @1483272000000", str(M.Months.current_week((1483272n * 1000000n + 0n : Nat), 6n)), "2016-12-31"},
    T.Check{"isCurrentMonth(2017-01)", Bool.show(M.Months.is_current_month("2017-01", (1483272n * 1000000n + 0n : Nat))), "True"},
    T.Check{"isCurrentMonth(2017-01-15)", Bool.show(M.Months.is_current_month("2017-01-15", (1483272n * 1000000n + 0n : Nat))), "True"} ]

