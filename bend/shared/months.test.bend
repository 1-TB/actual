    T.Check{"monthFromDate(\"2100-02-29\")", str(M.Months.month_from_date("2100-02-29")), "2100-03"},
    T.Check{"dayFromDate(\"2100-02-29\")", str(M.Months.day_from_date("2100-02-29")), "2100-03-01"},
