    T.Check{"formatDistance(2030, 2024-06-15, false, false)", str(M.Months.format_distance("2030", "2024-06-15", False{}, False{})), "over 5 years"},
    T.Check{"formatDistance(2030, 2024-06-15, true, true)", str(M.Months.format_distance("2030", "2024-06-15", True{}, True{})), "in over 5 years"},
    T.Check{"formatDistance(2024-06-15, 2030, true, false)", str(M.Months.format_distance("2024-06-15", "2030", True{}, False{})), "over 5 years ago"},
    T.Check{"formatDistance(bad, 2024-01-01, false, false)", str(M.Months.format_distance("bad", "2024-01-01", False{}, False{})), "throws"},
    T.Check{"formatDistance(bad, 2024-01-01, true, true)", str(M.Months.format_distance("bad", "2024-01-01", True{}, True{})), "throws"},
    T.Check{"formatDistance(2024-01-01, bad, true, false)", str(M.Months.format_distance("2024-01-01", "bad", True{}, False{})), "throws"},
    T.Check{"formatDistance(2024-01-01, bad, false, false)", str(M.Months.format_distance("2024-01-01", "bad", False{}, False{})), "throws"},
    T.Check{"formatDistance(2024-01-01, bad, true, true)", str(M.Months.format_distance("2024-01-01", "bad", True{}, True{})), "throws"},
    T.Check{"formatDistance(bad, 2024-01-01, true, false)", str(M.Months.format_distance("bad", "2024-01-01", True{}, False{})), "throws"},
    T.Check{"formatDistance(2024-01-01, 2024-01-01, false, false)", str(M.Months.format_distance("2024-01-01", "2024-01-01", False{}, False{})), "less than a minute"},
    T.Check{"formatDistance(2024-01-01, 2024-01-01, false, true)", str(M.Months.format_distance("2024-01-01", "2024-01-01", False{}, True{})), "less than 5 seconds"} ]

