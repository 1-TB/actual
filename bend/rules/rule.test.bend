# Checks for rule.bend (and transactions.bend) against
# packages/loot-core/src/server/rules/rule.ts: the Rule cases of
# index.test.ts that involve no template, formula or recurring date, and many
# more, including random split rules. Generated by running the TypeScript;
# expected values are its real outputs. A check of `run` is
# "evalConditions|exec|apply" as JSON (acts is execActions), with the random ids of new
# split parts replaced by id1, id2, ... in order of appearance.
import Base
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./types.bend as Y
import ./rule.bend as R

def ids() -> List<&2, String>:
  ["id0", "id1", "id2", "id3", "id4", "id5", "id6", "id7", "id8"]

def made.of(r: Result<&2, &2, Y.RuleError, Y.Rule>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{rule}:
      V.Txn.show(R.Rule.serialize(rule))

def made(spec: List<&2, V.Field>) -> String:
  made.of(R.Rule.new(spec))

def shown(r: Result<&2, &2, String, List<&2, V.Field>>) -> String:
  match r:
    case Fail{e}:
      "TypeError: " ++ e
    case Done{t}:
      V.Txn.show(t)

def shown_maybe(r: Result<&2, &2, String, Maybe<&2, List<&2, V.Field>>>) -> String:
  match r:
    case Fail{e}:
      "TypeError: " ++ e
    case Done{None{}}:
      "null"
    case Done{Some{t}}:
      V.Txn.show(t)

def run.of(r: Result<&2, &2, Y.RuleError, Y.Rule>, +object: List<&2, V.Field>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{+rule}:
      Bool.pick(String, R.Rule.eval_conditions(rule, object), "1", "0") ++ "|" ++
        shown_maybe(R.Rule.exec(rule, object, ids())) ++ "|" ++ shown(R.Rule.apply(rule, object, ids()))

def run(spec: List<&2, V.Field>, object: List<&2, V.Field>) -> String:
  run.of(R.Rule.new(spec), object)

def acts.of(r: Result<&2, &2, Y.RuleError, Y.Rule>, object: List<&2, V.Field>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{rule}:
      shown(R.Rule.exec_actions(rule, object, ids()))

def acts(spec: List<&2, V.Field>, object: List<&2, V.Field>) -> String:
  acts.of(R.Rule.new(spec), object)

