def part_1() -> List<&2, T.Test.Check>:
  [ T.Check{"1 rule_1 new", made(rule_1()), "internal: RuleError: Invalid condition field: name"},
    T.Check{"2 rule_2 new", made(rule_2()), "{\"stage\":null,\"conditionsOp\":\"and\",\"conditions\":[{\"op\":\"is\",\"field\":\"notes\",\"value\":\"James\",\"type\":\"string\"}],\"actions\":[{\"op\":\"set\",\"field\":\"notes\",\"value\":\"Sarah\",\"type\":\"string\"}]}"},
    T.Check{"3 rule_2 {\"notes\":\"James\",\"date\":\"2018-01-12\"}", run(rule_2(), [V.Field{"notes", V.VStr{"James"}}, V.Field{"date", V.VStr{"2018-01-12"}}]), "1|{\"notes\":\"Sarah\"}|{\"notes\":\"Sarah\",\"date\":\"2018-01-12\"}"},
    T.Check{"4 rule_2 execActions {\"notes\":\"James\",\"date\":\"2018-01-12\"}", acts(rule_2(), [V.Field{"notes", V.VStr{"James"}}, V.Field{"date", V.VStr{"2018-01-12"}}]), "{\"notes\":\"Sarah\"}"},
    T.Check{"5 rule_2 {\"notes\":\"james\",\"date\":\"2018-01-10\",\"cleared\":true}", run(rule_2(), [V.Field{"notes", V.VStr{"james"}}, V.Field{"date", V.VStr{"2018-01-10"}}, V.Field{"cleared", V.VBool{True{}}}]), "1|{\"notes\":\"Sarah\"}|{\"notes\":\"Sarah\",\"date\":\"2018-01-10\",\"cleared\":true}"},
    T.Check{"6 rule_2 {\"notes\":\"x\",\"amount\":5}", run(rule_2(), [V.Field{"notes", V.VStr{"x"}}, V.Field{"amount", V.Value.nat(5n)}]), "0|null|{\"notes\":\"x\",\"amount\":5}"},
    T.Check{"7 rule_2 {}", run(rule_2(), []), "0|null|{}"},
    T.Check{"8 rule_2 {\"name\":\"James\",\"notes\":null,\"payee\":\"p1\",\"amount\":-1050,\"account\":\"a1\",\"_account\":{\"offbudget\":0}}", run(rule_2(), [V.Field{"name", V.VStr{"James"}}, V.Field{"notes", V.VNull{}}, V.Field{"payee", V.VStr{"p1"}}, V.Field{"amount", V.Value.minus(1050n)}, V.Field{"account", V.VStr{"a1"}}, V.Field{"_account", V.Value.object([V.Field{"offbudget", V.Value.nat(0n)}])}]), "0|null|{\"name\":\"James\",\"notes\":null,\"payee\":\"p1\",\"amount\":-1050,\"account\":\"a1\",\"_account\":{\"offbudget\":0}}"},
    T.Check{"9 rule_2 {\"id\":\"T1\",\"notes\":\"Sarah\",\"payee_name\":\"n\",\"payee\":\"new\",\"tombstone\":1,\"schedule\":\"s\"}", run(rule_2(), [V.Field{"id", V.VStr{"T1"}}, V.Field{"notes", V.VStr{"Sarah"}}, V.Field{"payee_name", V.VStr{"n"}}, V.Field{"payee", V.VStr{"new"}}, V.Field{"tombstone", V.Value.nat(1n)}, V.Field{"schedule", V.VStr{"s"}}]), "0|null|{\"id\":\"T1\",\"notes\":\"Sarah\",\"payee_name\":\"n\",\"payee\":\"new\",\"tombstone\":1,\"schedule\":\"s\"}"},
    T.Check{"10 rule_3 new", made(rule_3()), "{\"stage\":null,\"conditionsOp\":\"and\",\"conditions\":[{\"op\":\"is\",\"field\":\"cleared\",\"value\":true,\"type\":\"boolean\"}],\"actions\":[{\"op\":\"set\",\"field\":\"notes\",\"value\":\"Sarah\",\"type\":\"string\"}]}"},
    T.Check{"11 rule_3 {\"notes\":\"James\",\"date\":\"2018-01-12\"}", run(rule_3(), [V.Field{"notes", V.VStr{"James"}}, V.Field{"date", V.VStr{"2018-01-12"}}]), "0|null|{\"notes\":\"James\",\"date\":\"2018-01-12\"}"},
    T.Check{"12 rule_3 execActions {\"notes\":\"James\",\"date\":\"2018-01-12\"}", acts(rule_3(), [V.Field{"notes", V.VStr{"James"}}, V.Field{"date", V.VStr{"2018-01-12"}}]), "{\"notes\":\"Sarah\"}"},
    T.Check{"13 rule_3 {\"notes\":\"james\",\"date\":\"2018-01-10\",\"cleared\":true}", run(rule_3(), [V.Field{"notes", V.VStr{"james"}}, V.Field{"date", V.VStr{"2018-01-10"}}, V.Field{"cleared", V.VBool{True{}}}]), "1|{\"notes\":\"Sarah\"}|{\"notes\":\"Sarah\",\"date\":\"2018-01-10\",\"cleared\":true}"},
