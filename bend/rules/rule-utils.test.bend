# Checks for rule-utils.bend against
# packages/loot-core/src/server/rules/rule-utils.ts (the cases of
# rule-utils.test.ts and more). Generated by running the TypeScript; expected
# values are its real outputs.
import Base
import ../lib/core.bend as C
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./types.bend as Y
import ./rule-utils.bend as U

def parsed(m: Maybe<&2, Y.Parsed>) -> String:
  match m:
    case None{}:
      "null"
    case Some{p}:
      V.Value.show(Y.Parsed.to_value(p))

def date(v: V.Value) -> String:
  parsed(U.RuleUtils.parse_date_string(v))

def date_of(s: String) -> String:
  date(V.VStr{s})

def date_all(xs: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{date_of(h), date_all(t)}

def dates(xs: List<&2, String>) -> String:
  String.join(date_all(xs), ";")

def between(v: V.Value) -> String:
  parsed(U.RuleUtils.parse_between_amount(v))

