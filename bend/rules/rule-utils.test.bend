def rule_of(spec: List<&2, V.Field>) -> Y.Rule:
  Result.default(&2, &2, Y.RuleError, Y.Rule, R.Rule.new(spec), Y.Rule{V.VMissing{}, V.VNull{}, V.VMissing{}, Nil{}, Nil{}})

def rule_at(i: Nat) -> Y.Rule:
  rule_of(Maybe.default(&2, List<&2, V.Field>, List.get(&2, List<&2, V.Field>, pool(), i), Nil{}))

def rules_at(ns: List<&2, Nat>) -> List<&2, Y.Rule>:
  match ns:
    case Nil{}:
      Nil{}
    case Con{i, t}:
      Con{rule_at(i), rules_at(t)}

def ids(rules: List<&2, Y.Rule>) -> List<&2, String>:
  match rules:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{V.Value.to_string(R.Rule.get_id(r)), ids(t)}

def rank(ns: List<&2, Nat>) -> String:
  String.join(ids(U.RuleUtils.rank_rules(rules_at(ns))), ",")

def cond_values(conds: List<&2, Y.Condition>) -> List<&2, V.Value>:
  match conds:
    case Nil{}:
      Nil{}
    case Con{Y.Cond{op, field, value, raw, unparsed, options, kind}, t}:
      Con{V.Value.array([raw, Y.Parsed.to_value(value), unparsed]), cond_values(t)}

def action_values(actions: List<&2, Y.Action>) -> List<&2, V.Value>:
  match actions:
    case Nil{}:
      Nil{}
    case Con{Y.Act{op, field, value, raw, options, kind}, t}:
      Con{V.Value.array([raw, value]), action_values(t)}

def migrated(+rule: Y.Rule) -> String:
  match rule:
    case Y.Rule{id, stage, conditions_op, conditions, actions}:
      V.Value.show(V.Value.array(cond_values(conditions))) ++ V.Value.show(V.Value.array(action_values(actions))) ++
        V.Txn.show(R.Rule.serialize(rule))

def migrate(i: Nat, mappings: List<&2, U.RuleUtils.Mapping>) -> String:
  migrated(U.RuleUtils.migrate_ids(rule_at(i), mappings))

def migrate_spec(spec: List<&2, V.Field>, mappings: List<&2, U.RuleUtils.Mapping>) -> String:
  migrated(U.RuleUtils.migrate_ids(rule_of(spec), mappings))

# The calls of one rule: its ids up to and including the first that equals
# stop, where the callback answers true and iterateIds leaves the rule.
def calls.rule(ids: List<&2, V.Value>, +name: String, +stop: V.Value) -> List<&2, String>:
  match ids:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      Con{name ++ ":" ++ V.Value.show(id),
        C.If(List<&2, String>, V.Value.strict_eq(id, stop), u => Nil{}, u => calls.rule(t, name, stop))}

def calls(visits: List<&2, U.RuleUtils.Visit>, +stop: V.Value) -> List<&2, String>:
  match visits:
    case Nil{}:
      Nil{}
    case Con{U.Visit{rule, ids}, t}:
      List.append(&2, String, calls.rule(ids, V.Value.to_string(R.Rule.get_id(rule)), stop), calls(t, stop))

def all_rules(specs: List<&2, List<&2, V.Field>>) -> List<&2, Y.Rule>:
  match specs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{rule_of(h), all_rules(t)}

def iterate(field: String, stop: V.Value) -> String:
  String.join(calls(U.RuleUtils.iterate_ids(all_rules(pool()), field), stop), ",")

def parsed(m: Maybe<&2, Y.Parsed>) -> String:
  match m:
    case None{}:
      "null"
    case Some{p}:
      V.Value.show(Y.Parsed.to_value(p))

def date(v: V.Value) -> String:
  parsed(U.RuleUtils.parse_date_string(v))

def date_of(s: String) -> String:
  date(V.VStr{s})

def date_all(xs: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{date_of(h), date_all(t)}

def dates(xs: List<&2, String>) -> String:
  String.join(date_all(xs), ";")

def between(v: V.Value) -> String:
  parsed(U.RuleUtils.parse_between_amount(v))

