# Checks for rules.bend against packages/loot-core/src/shared/rules.ts
# (the cases of shared/rules.test.ts and more). Generated by running the
# TypeScript; expected values are its real outputs.
import Base
import ../lib/core.bend as C
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./rules.bend as R

def ops(xs: List<&2, String>) -> String:
  String.join(xs, ",")

def all_ops() -> List<&2, String>:
  ["is", "isNot", "oneOf", "notOneOf", "contains", "doesNotContain", "matches", "gt", "gte", "lt", "lte", "isapprox", "isbetween", "hasTags", "hasAnyTag", "onBudget", "offBudget", "and", "or", "bogus"]

def keep(xs: List<&2, String>, +field: String) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      C.If(List<&2, String>, R.Rules.is_valid_op(field, h), u => Con{h, keep(t, field)}, u => keep(t, field))

def valid(field: String) -> String:
  ops(keep(all_ops(), field))

def num(v: V.Value) -> N.Num:
  V.Value.num(v)

def pair(p: N.Num & N.Num) -> String:
  (a, b) = p
  N.Num.show(a) ++ "," ++ N.Num.show(b)

def part_1() -> List<&2, T.Test.Check>:
  [ T.Check{"1 validOps imported_payee", ops(R.Rules.get_valid_ops("imported_payee")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf"},
    T.Check{"2 isValidOp imported_payee", valid("imported_payee"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches"},
    T.Check{"3 type imported_payee", Maybe.default(&2, String, R.Rules.field_type("imported_payee"), "undefined"), "string"},
    T.Check{"4 validOps payee", ops(R.Rules.get_valid_ops("payee")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf"},
    T.Check{"5 isValidOp payee", valid("payee"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches"},
    T.Check{"6 type payee", Maybe.default(&2, String, R.Rules.field_type("payee"), "undefined"), "id"},
    T.Check{"7 validOps payee_name", ops(R.Rules.get_valid_ops("payee_name")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf,hasTags,hasAnyTag"},
    T.Check{"8 isValidOp payee_name", valid("payee_name"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches,hasTags,hasAnyTag"},
    T.Check{"9 type payee_name", Maybe.default(&2, String, R.Rules.field_type("payee_name"), "undefined"), "string"},
    T.Check{"10 validOps date", ops(R.Rules.get_valid_ops("date")), "is,isapprox,gt,gte,lt,lte"},
    T.Check{"11 isValidOp date", valid("date"), "is,gt,gte,lt,lte,isapprox"},
    T.Check{"12 type date", Maybe.default(&2, String, R.Rules.field_type("date"), "undefined"), "date"},
    T.Check{"13 validOps notes", ops(R.Rules.get_valid_ops("notes")), "is,contains,matches,isNot,doesNotContain,hasTags,hasAnyTag"},
    T.Check{"14 isValidOp notes", valid("notes"), "is,isNot,contains,doesNotContain,matches,hasTags,hasAnyTag"},
    T.Check{"15 type notes", Maybe.default(&2, String, R.Rules.field_type("notes"), "undefined"), "string"},
    T.Check{"16 validOps amount", ops(R.Rules.get_valid_ops("amount")), "is,isapprox,isbetween,gt,gte,lt,lte"},
    T.Check{"17 isValidOp amount", valid("amount"), "is,gt,gte,lt,lte,isapprox,isbetween"},
    T.Check{"18 type amount", Maybe.default(&2, String, R.Rules.field_type("amount"), "undefined"), "number"},
    T.Check{"19 validOps category", ops(R.Rules.get_valid_ops("category")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf"},
    T.Check{"20 isValidOp category", valid("category"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches,and"},
    T.Check{"21 type category", Maybe.default(&2, String, R.Rules.field_type("category"), "undefined"), "id"},
    T.Check{"22 validOps category_group", ops(R.Rules.get_valid_ops("category_group")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf"},
    T.Check{"23 isValidOp category_group", valid("category_group"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches,and"},
    T.Check{"24 type category_group", Maybe.default(&2, String, R.Rules.field_type("category_group"), "undefined"), "id"},
    T.Check{"25 validOps account", ops(R.Rules.get_valid_ops("account")), "is,contains,matches,oneOf,isNot,doesNotContain,notOneOf,onBudget,offBudget"} ]

def part_2() -> List<&2, T.Test.Check>:
  [ T.Check{"26 isValidOp account", valid("account"), "is,isNot,oneOf,notOneOf,contains,doesNotContain,matches,onBudget,offBudget"},
    T.Check{"27 type account", Maybe.default(&2, String, R.Rules.field_type("account"), "undefined"), "id"},
    T.Check{"28 validOps cleared", ops(R.Rules.get_valid_ops("cleared")), "is"},
    T.Check{"29 isValidOp cleared", valid("cleared"), "is"},
    T.Check{"30 type cleared", Maybe.default(&2, String, R.Rules.field_type("cleared"), "undefined"), "boolean"},
    T.Check{"31 validOps reconciled", ops(R.Rules.get_valid_ops("reconciled")), "is"},
    T.Check{"32 isValidOp reconciled", valid("reconciled"), "is"},
    T.Check{"33 type reconciled", Maybe.default(&2, String, R.Rules.field_type("reconciled"), "undefined"), "boolean"},
    T.Check{"34 validOps saved", ops(R.Rules.get_valid_ops("saved")), ""},
    T.Check{"35 isValidOp saved", valid("saved"), ""},
    T.Check{"36 type saved", Maybe.default(&2, String, R.Rules.field_type("saved"), "undefined"), "saved"},
    T.Check{"37 validOps transfer", ops(R.Rules.get_valid_ops("transfer")), "is"},
    T.Check{"38 isValidOp transfer", valid("transfer"), "is"},
    T.Check{"39 type transfer", Maybe.default(&2, String, R.Rules.field_type("transfer"), "undefined"), "boolean"},
    T.Check{"40 validOps parent", ops(R.Rules.get_valid_ops("parent")), "is"},
    T.Check{"41 isValidOp parent", valid("parent"), "is"},
    T.Check{"42 type parent", Maybe.default(&2, String, R.Rules.field_type("parent"), "undefined"), "boolean"},
    T.Check{"43 validOps bogus", ops(R.Rules.get_valid_ops("bogus")), ""},
    T.Check{"44 isValidOp bogus", valid("bogus"), ""},
    T.Check{"45 type bogus", Maybe.default(&2, String, R.Rules.field_type("bogus"), "undefined"), "undefined"},
    T.Check{"46 validOps ", ops(R.Rules.get_valid_ops("")), ""},
    T.Check{"47 isValidOp ", valid(""), ""},
    T.Check{"48 type ", Maybe.default(&2, String, R.Rules.field_type(""), "undefined"), "undefined"},
    T.Check{"49 fields", ops(R.Rules.fields()), "imported_payee,payee,payee_name,date,notes,amount,category,category_group,account,cleared,reconciled,saved,transfer,parent"},
    T.Check{"50 deserializeField amount-inflow", V.Txn.show(R.Rules.deserialize_field("amount-inflow")), "{\"field\":\"amount\",\"options\":{\"inflow\":true}}"} ]

def part_3() -> List<&2, T.Test.Check>:
  [ T.Check{"51 deserializeField amount-outflow", V.Txn.show(R.Rules.deserialize_field("amount-outflow")), "{\"field\":\"amount\",\"options\":{\"outflow\":true}}"},
    T.Check{"52 deserializeField amount", V.Txn.show(R.Rules.deserialize_field("amount")), "{\"field\":\"amount\"}"},
    T.Check{"53 deserializeField payee", V.Txn.show(R.Rules.deserialize_field("payee")), "{\"field\":\"payee\"}"},
    T.Check{"54 deserializeField ", V.Txn.show(R.Rules.deserialize_field("")), "{\"field\":\"\"}"},
    T.Check{"55 getFieldError date-format", R.Rules.get_field_error("date-format"), "Invalid date format"},
    T.Check{"56 getFieldError no-null", R.Rules.get_field_error("no-null"), "Value cannot be empty"},
    T.Check{"57 getFieldError no-empty-array", R.Rules.get_field_error("no-empty-array"), "Value cannot be empty"},
    T.Check{"58 getFieldError no-empty-string", R.Rules.get_field_error("no-empty-string"), "Value cannot be empty"},
    T.Check{"59 getFieldError not-string", R.Rules.get_field_error("not-string"), "Value must be a string"},
    T.Check{"60 getFieldError not-boolean", R.Rules.get_field_error("not-boolean"), "Value must be a boolean"},
    T.Check{"61 getFieldError not-number", R.Rules.get_field_error("not-number"), "Value must be a number"},
    T.Check{"62 getFieldError invalid-field", R.Rules.get_field_error("invalid-field"), "Please choose a valid field for this type of rule"},
    T.Check{"63 getFieldError invalid-template", R.Rules.get_field_error("invalid-template"), "Invalid handlebars template"},
    T.Check{"64 getFieldError internal", R.Rules.get_field_error("internal"), "Internal error, sorry! Please get in touch https://actualbudget.org/contact/ for support"},
    T.Check{"65 getFieldError ", R.Rules.get_field_error(""), "Internal error, sorry! Please get in touch https://actualbudget.org/contact/ for support"},
    T.Check{"66 sortNumbers 1 2", pair(R.Rules.sort_numbers(num(V.Value.nat(1n)), num(V.Value.nat(2n)))), "1,2"},
    T.Check{"67 sortNumbers 2 1", pair(R.Rules.sort_numbers(num(V.Value.nat(2n)), num(V.Value.nat(1n)))), "1,2"},
    T.Check{"68 sortNumbers -5 3", pair(R.Rules.sort_numbers(num(V.Value.minus(5n)), num(V.Value.nat(3n)))), "-5,3"},
    T.Check{"69 sortNumbers 3 -5", pair(R.Rules.sort_numbers(num(V.Value.nat(3n)), num(V.Value.minus(5n)))), "-5,3"},
    T.Check{"70 sortNumbers 0 0", pair(R.Rules.sort_numbers(num(V.Value.nat(0n)), num(V.Value.nat(0n)))), "0,0"},
    T.Check{"71 sortNumbers 1.5 1.25", pair(R.Rules.sort_numbers(num(V.VNum{N.Num.make(False{}, 15n, 10n)}), num(V.VNum{N.Num.make(False{}, 125n, 100n)}))), "1.25,1.5"},
    T.Check{"72 sortNumbers -2 -3", pair(R.Rules.sort_numbers(num(V.Value.minus(2n)), num(V.Value.minus(3n)))), "-3,-2"},
    T.Check{"73 sortNumbers 100 100", pair(R.Rules.sort_numbers(num(V.Value.nat(100n)), num(V.Value.nat(100n)))), "100,100"},
    T.Check{"74 parse {\"op\":\"is\",\"field\":\"amount\",\"type\":\"number\",\"value\":5}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"amount"}}, V.Field{"type", V.VStr{"number"}}, V.Field{"value", V.Value.nat(5n)}])), "{\"op\":\"is\",\"field\":\"amount\",\"type\":\"number\",\"value\":5}"},
    T.Check{"75 unparse {\"op\":\"is\",\"field\":\"amount\",\"type\":\"number\",\"value\":5}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"amount"}}, V.Field{"type", V.VStr{"number"}}, V.Field{"value", V.Value.nat(5n)}])), "{\"op\":\"is\",\"field\":\"amount\",\"type\":\"number\",\"value\":5}"} ]

def part_4() -> List<&2, T.Test.Check>:
  [ T.Check{"76 parse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":null}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}, V.Field{"value", V.VNull{}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"\"}"},
    T.Check{"77 unparse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":null}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}, V.Field{"value", V.VNull{}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"\"}"},
    T.Check{"78 parse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"\"}"},
    T.Check{"79 unparse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"\"}"},
    T.Check{"80 parse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"x\",\"error\":\"bad\",\"inputKey\":\"k1\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}, V.Field{"value", V.VStr{"x"}}, V.Field{"error", V.VStr{"bad"}}, V.Field{"inputKey", V.VStr{"k1"}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"x\",\"error\":\"bad\",\"inputKey\":\"k1\"}"},
    T.Check{"81 unparse {\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"x\",\"error\":\"bad\",\"inputKey\":\"k1\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee_name"}}, V.Field{"type", V.VStr{"string"}}, V.Field{"value", V.VStr{"x"}}, V.Field{"error", V.VStr{"bad"}}, V.Field{"inputKey", V.VStr{"k1"}}])), "{\"op\":\"is\",\"field\":\"payee_name\",\"type\":\"string\",\"value\":\"x\"}"},
    T.Check{"82 parse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":null}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}, V.Field{"value", V.VNull{}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":null}"},
    T.Check{"83 unparse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":null}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}, V.Field{"value", V.VNull{}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":false}"},
    T.Check{"84 parse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\"}"},
    T.Check{"85 unparse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":false}"},
    T.Check{"86 parse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":true,\"inputKey\":\"zz\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}, V.Field{"value", V.VBool{True{}}}, V.Field{"inputKey", V.VStr{"zz"}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":true,\"inputKey\":\"zz\"}"},
    T.Check{"87 unparse {\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":true,\"inputKey\":\"zz\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"cleared"}}, V.Field{"type", V.VStr{"boolean"}}, V.Field{"value", V.VBool{True{}}}, V.Field{"inputKey", V.VStr{"zz"}}])), "{\"op\":\"is\",\"field\":\"cleared\",\"type\":\"boolean\",\"value\":true}"},
    T.Check{"88 parse {\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee"}}, V.Field{"type", V.VStr{"id"}}, V.Field{"value", V.VStr{"abc"}}])), "{\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\",\"error\":null}"},
    T.Check{"89 unparse {\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee"}}, V.Field{"type", V.VStr{"id"}}, V.Field{"value", V.VStr{"abc"}}])), "{\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\"}"},
    T.Check{"90 parse {\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\",\"error\":{\"type\":\"x\"}}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee"}}, V.Field{"type", V.VStr{"id"}}, V.Field{"value", V.VStr{"abc"}}, V.Field{"error", V.Value.object([V.Field{"type", V.VStr{"x"}}])}])), "{\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\",\"error\":null}"},
    T.Check{"91 unparse {\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\",\"error\":{\"type\":\"x\"}}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"payee"}}, V.Field{"type", V.VStr{"id"}}, V.Field{"value", V.VStr{"abc"}}, V.Field{"error", V.Value.object([V.Field{"type", V.VStr{"x"}}])}])), "{\"op\":\"is\",\"field\":\"payee\",\"type\":\"id\",\"value\":\"abc\"}"},
    T.Check{"92 parse {\"op\":\"is\",\"field\":\"date\",\"type\":\"date\",\"value\":\"2020-01-01\"}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"date"}}, V.Field{"type", V.VStr{"date"}}, V.Field{"value", V.VStr{"2020-01-01"}}])), "{\"op\":\"is\",\"field\":\"date\",\"type\":\"date\",\"value\":\"2020-01-01\",\"error\":null}"},
    T.Check{"93 unparse {\"op\":\"is\",\"field\":\"date\",\"type\":\"date\",\"value\":\"2020-01-01\"}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"is"}}, V.Field{"field", V.VStr{"date"}}, V.Field{"type", V.VStr{"date"}}, V.Field{"value", V.VStr{"2020-01-01"}}])), "{\"op\":\"is\",\"field\":\"date\",\"type\":\"date\",\"value\":\"2020-01-01\"}"},
    T.Check{"94 parse {\"op\":\"set-split-amount\",\"value\":100,\"options\":{\"method\":\"fixed-amount\",\"splitIndex\":1}}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.Value.nat(100n)}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-amount"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}])), "{\"op\":\"set-split-amount\",\"value\":100,\"options\":{\"method\":\"fixed-amount\",\"splitIndex\":1}}"},
    T.Check{"95 unparse {\"op\":\"set-split-amount\",\"value\":100,\"options\":{\"method\":\"fixed-amount\",\"splitIndex\":1}}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.Value.nat(100n)}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-amount"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}])), "{\"op\":\"set-split-amount\",\"value\":100,\"options\":{\"method\":\"fixed-amount\",\"splitIndex\":1}}"},
    T.Check{"96 parse {\"op\":\"set-split-amount\",\"value\":\"25.5\",\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1},\"error\":null}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.VStr{"25.5"}}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}, V.Field{"error", V.VNull{}}])), "{\"op\":\"set-split-amount\",\"value\":\"25.5\",\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1},\"error\":null}"},
    T.Check{"97 unparse {\"op\":\"set-split-amount\",\"value\":\"25.5\",\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1},\"error\":null}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.VStr{"25.5"}}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}, V.Field{"error", V.VNull{}}])), "{\"op\":\"set-split-amount\",\"value\":25.5,\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1}}"},
    T.Check{"98 parse {\"op\":\"set-split-amount\",\"value\":30,\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1}}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.Value.nat(30n)}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}])), "{\"op\":\"set-split-amount\",\"value\":30,\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1}}"},
    T.Check{"99 unparse {\"op\":\"set-split-amount\",\"value\":30,\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1}}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.Value.nat(30n)}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}, V.Field{"splitIndex", V.Value.nat(1n)}])}])), "{\"op\":\"set-split-amount\",\"value\":30,\"options\":{\"method\":\"fixed-percent\",\"splitIndex\":1}}"},
    T.Check{"100 parse {\"op\":\"set-split-amount\",\"value\":\"abc\",\"options\":{\"method\":\"fixed-percent\"}}", V.Txn.show(R.Rules.parse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.VStr{"abc"}}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}])}])), "{\"op\":\"set-split-amount\",\"value\":\"abc\",\"options\":{\"method\":\"fixed-percent\"}}"} ]

def part_5() -> List<&2, T.Test.Check>:
  [ T.Check{"101 unparse {\"op\":\"set-split-amount\",\"value\":\"abc\",\"options\":{\"method\":\"fixed-percent\"}}", V.Txn.show(R.Rules.unparse([V.Field{"op", V.VStr{"set-split-amount"}}, V.Field{"value", V.VStr{"abc"}}, V.Field{"options", V.Value.object([V.Field{"method", V.VStr{"fixed-percent"}}])}])), "{\"op\":\"set-split-amount\",\"value\":null,\"options\":{\"method\":\"fixed-percent\"}}"},
