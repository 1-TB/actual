    T.Check{"182 threshold 26.666", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.VNum{N.Num.make(False{}, 26666n, 1000n)}))}), "2"},
    T.Check{"183 threshold 100000000", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.Value.nat(100000000n)))}), "7500000"},
    T.Check{"184 threshold 1234567890", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.Value.nat(1234567890n)))}), "92592592"} ]

def main() -> IO(Unit):
  T.Test.run(List.concat(&2, T.Test.Check, [part_1(), part_2(), part_3(), part_4(), part_5(), part_6(), part_7(), part_8()]))
