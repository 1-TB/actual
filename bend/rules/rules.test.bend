def part_8() -> List<&2, T.Test.Check>:
  [ T.Check{"176 threshold 999999", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.Value.nat(999999n)))}), "75000"},
    T.Check{"177 threshold 20000020", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.Value.nat(20000020n)))}), "1500002"},
    T.Check{"178 threshold 33", V.Value.show(V.VNum{R.Rules.approx_threshold(num(V.Value.nat(33n)))}), "2"},
