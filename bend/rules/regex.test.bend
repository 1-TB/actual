# Checks for regex.bend against the JS RegExp of the Node that generated
# this file: each pattern is tested on every text of `texts` and the answers
# are written as a row of 0s and 1s ("invalid" where JS throws a SyntaxError,
# "unsupported" for syntax regex.bend declines).
import Base
import ../lib/test.bend as T
import ./regex.bend as R

def texts() -> List<&2, String>:
  ["", "a", "b", "ab", "abc", "aab", "abab", "ABC", "foo", "fo", "fooo", "foo bar", "bar foo", "foobar", "a.b", "a\nb", "a b", "123", "a1", "1a2b3", "_x", "x-y", "hello world", "Hello World", "aaa", "aaaa", "aaaaaa", "abcabc", "xyz", "{", "a{2}", "a{", "}", "]", "[", "(", ")", "\\", "a\\b", "\t", " ", "\u{e9}", "\u{c9}", "stra\u{df}e", "\u{41f}\u{420}\u{418}\u{412}\u{415}\u{422}", "\u{43f}\u{440}\u{438}\u{432}\u{435}\u{442}", "costco #123", "amazon.com*ab12", "AMZN Mktp US", "payment 12/05", "ab12", "a-b", "-", "^", "$", "a$", "^a", "a|b", "a*", "a+", "a?", "\u{1}", "A", "k", "u", "x", "c", "B", "\u{8}", "a]", "ac", "abbbc", "abd", "acd", "bcd", "0", "9", "caf\u{e9} 5", "x\u{2028}y", "x\ry", "\u{df}", "\u{1f600}", "a\u{1f600}b", "uuu", "aa", "\\c", "\u{0}", "d", "w", "abcd", "one two three", "aXb", "a_b", "ab ", " ab", "foo123bar", "foo-bar", "foo.bar", "2020-01-15", "15/01/2020", "a,b", "q", "aq", "qa", "\u{3c3}", "\u{3a3}", "\u{ff}", "\u{f7}", "\u{d7}"]

def bits(xs: List<&2, String>, +node: R.Regex.Node, +ic: Bool) -> String:
  match xs:
    case Nil{}:
      SNil{}
    case Con{h, t}:
      SCon{Bool.pick(Char, R.Regex.exec(node, ic, h), '1', '0'), bits(t, node, ic)}

def rx.of(r: Result<&2, &2, String, R.Regex.Node>, ic: Bool, xs: List<&2, String>) -> String:
  match r:
    case Fail{+e}:
      String.take(e, Bool.pick(Nat, String.starts_with(e, "invalid"), 7n, 11n))
    case Done{node}:
      bits(xs, node, ic)

def rx(pattern: String, ic: Bool, xs: List<&2, String>) -> String:
  rx.of(R.Regex.compile(pattern), ic, xs)

