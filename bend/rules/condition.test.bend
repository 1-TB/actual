# Checks for condition.bend against
# packages/loot-core/src/server/rules/condition.ts (the Condition cases of
# index.test.ts and many more). Generated by running the TypeScript; expected
# values are its real outputs: for a constructor, the serialized condition and
# its parsed value, or the RuleError's type and message; for `eval`, one 0 or
# 1 per transaction.
import Base
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./types.bend as Y
import ./condition.bend as K

def made(r: Result<&2, &2, Y.RuleError, Y.Condition>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{+c}:
      V.Txn.show(K.Condition.serialize(c)) ++ "|" ++ V.Value.show(K.Condition.get_value(c))

def mk(op: String, field: String, value: V.Value, options: V.Value) -> String:
  made(K.Condition.new(op, field, value, options))

def mks.go(values: List<&2, V.Value>, +op: String, +field: String) -> List<&2, String>:
  match values:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{mk(op, field, h, V.VNull{}), mks.go(t, op, field)}

def mks(op: String, field: String, values: List<&2, V.Value>) -> String:
  String.join(mks.go(values, op, field), ";")

def bits(objs: List<&2, List<&2, V.Field>>, +c: Y.Condition) -> String:
  match objs:
    case Nil{}:
      SNil{}
    case Con{h, t}:
      SCon{Bool.pick(Char, K.Condition.eval(c, h), '1', '0'), bits(t, c)}

def ev.of(r: Result<&2, &2, Y.RuleError, Y.Condition>, objs: List<&2, List<&2, V.Field>>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{c}:
      bits(objs, c)

def ev(op: String, field: String, value: V.Value, options: V.Value, objs: List<&2, List<&2, V.Field>>) -> String:
  ev.of(K.Condition.new(op, field, value, options), objs)

