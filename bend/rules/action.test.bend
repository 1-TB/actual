# Checks for action.bend against
# packages/loot-core/src/server/rules/action.ts (the Action cases of
# index.test.ts that involve no template, and many more). Generated by
# running the TypeScript; expected values are its real outputs: for a
# constructor the serialized action or the RuleError's type and message, for
# `exec` the transaction afterwards as JSON.
import Base
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./types.bend as Y
import ./action.bend as A

def made(r: Result<&2, &2, Y.RuleError, Y.Action>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{a}:
      V.Txn.show(A.Action.serialize(a))

def mk(op: String, field: V.Value, value: V.Value, options: V.Value) -> String:
  made(A.Action.new(op, field, value, options))

def mks.go(values: List<&2, V.Value>, options: List<&2, V.Value>, +op: String, +field: V.Value) -> List<&2, String>:
  match values options:
    case Con{v, vs} Con{o, os}:
      Con{mk(op, field, v, o), mks.go(vs, os, op, field)}
    case _ _:
      Nil{}

def mks(op: String, field: V.Value, values: List<&2, V.Value>, options: List<&2, V.Value>) -> String:
  String.join(mks.go(values, options, op, field), ";")

def objs() -> List<&2, List<&2, V.Field>>:
  [[], [V.Field{"id", V.VStr{"a"}}, V.Field{"notes", V.VStr{"hello"}}, V.Field{"amount", V.Value.nat(5n)}, V.Field{"payee", V.VStr{"p"}}, V.Field{"payee_name", V.VStr{"n"}}], [V.Field{"notes", V.VStr{""}}], [V.Field{"notes", V.VNull{}}, V.Field{"schedule", V.VStr{"s"}}, V.Field{"tombstone", V.Value.nat(0n)}], [V.Field{"notes", V.Value.nat(7n)}, V.Field{"amount", V.VNull{}}], [V.Field{"amount", V.Value.nat(1n)}, V.Field{"notes", V.VBool{True{}}}, V.Field{"account", V.VStr{"acct"}}, V.Field{"date", V.VStr{"2020-01-01"}}, V.Field{"cleared", V.VBool{False{}}}, V.Field{"category", V.VNull{}}]]

def done(r: Result<&2, &2, String, List<&2, V.Field>>) -> String:
  match r:
    case Fail{e}:
      "TypeError: " ++ e
    case Done{t}:
      V.Txn.show(t)

def ex.all(objs: List<&2, List<&2, V.Field>>, +a: Y.Action) -> List<&2, String>:
  match objs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{done(A.Action.exec(a, h)), ex.all(t, a)}

def ex.of(r: Result<&2, &2, Y.RuleError, Y.Action>) -> String:
  match r:
    case Fail{e}:
      Y.RuleError.show(e)
    case Done{a}:
      String.join(ex.all(objs(), a), ";")

def ex(op: String, field: V.Value, value: V.Value, options: V.Value) -> String:
  ex.of(A.Action.new(op, field, value, options))

