  [ T.Check{"1 single field", scen("notes", None{}, [5n, 15n]), "id3,c8;c8;c8;id3,c8;id3,c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8;c8|c8;;;;;id3;;;;;;;;;;|null;null;null;abc;x;null;\u{e9}a;null|c8;;id3;;c8"},
    T.Check{"2 firstchar", scen("category", Some{"firstchar"}, [29n, 31n, 25n]), "h13;h13;h13;j15,h13;j15,h13;j15,h13;k16,h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13;h13|h13;j15;k16;;;;;;;;;;;;;|null;null;null;a;x;null;\u{e9};null|h13;j15;;;h13"},
    T.Check{"3 re-index 1", scen("category", Some{"firstchar"}, [29n]), ";;;j15;j15;j15;;;;;;;;;;;;;;;;;;;;;;;|;j15;;;;;;;;;;;;;;|null;null;null;a;x;null;\u{e9};null|;j15;;;"},
    T.Check{"4 re-index 2", scen("category", Some{"firstchar"}, [29n, 28n]), ";;;;;;;;;;;;;;;;;;;;;;;;;;;;|;;;;;;;;;;;;;;;|null;null;null;a;x;null;\u{e9};null|;;;;"},
    T.Check{"5 re-index 3", scen("category", Some{"firstchar"}, [29n, 28n, 33n]), "l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17;l17|l17;l17;;l17;;;;;;;;;;;;|null;null;null;a;x;null;\u{e9};null|l17;l17;;;l17"},
    T.Check{"6 oneOf", scen("imported_payee", Some{"firstchar"}, [3n, 35n]), ";;;;;;;;;;;;id2;id2;;m18;id2;;;;;id2;;;;;;;|;;;;id2;;;;;;id2;id2;m18;;;|null;null;null;a;x;null;\u{e9};null|;;id2;;"},
    T.Check{"7 empty", scen("notes", None{}, []), ";;;;;;;;;;;;;;;;;;;;;;;;;;;;|;;;;;;;;;;;;;;;|null;null;null;abc;x;null;\u{e9}a;null|;;;;"},
    T.Check{"8 other method", scen("notes", Some{"bogus"}, [5n, 7n, 41n]), "id3,id4;;;id3,id4;id3,id4;;;;;;;;;;;;;;;;;;undefined;;;;;;|;;;;;id3,id4;;;;;;;;;;|null;null;null;abc;x;null;\u{e9}a;null|;;id3,id4;;"},
