# Checks for rule-indexer.bend against
# packages/loot-core/src/server/rules/rule-indexer.ts (the RuleIndexer cases
# of index.test.ts and more). Generated by running the TypeScript; expected
# values are its real outputs. A scenario indexes (odd number 2i + 1) or
# removes (even number 2i) rule i of the pool in turn, then lists the rule ids
# that getApplicableRules answers for each query, the ids filed under each
# key, getKey of some values, and getIndexForValue of some values.
import Base
import ../lib/test.bend as T
import ../lib/num.bend as N
import ./value.bend as V
import ./types.bend as Y
import ./rule.bend as R
import ./rule-indexer.bend as I

