def queries() -> List<&2, List<&2, V.Field>>:
  [[V.Field{"notes", V.VStr{"James"}}], [V.Field{"notes", V.VStr{"James2"}}], [V.Field{"amount", V.Value.nat(15n)}], [V.Field{"notes", V.VStr{"james"}}, V.Field{"category", V.VStr{"food"}}], [V.Field{"notes", V.VStr{"James"}}, V.Field{"category", V.VStr{"f"}}], [V.Field{"category", V.VStr{"Foo"}}], [V.Field{"category", V.VStr{"bars"}}], [V.Field{"category", V.VStr{"alco"}}], [V.Field{"category", V.VStr{""}}], [V.Field{"category", V.VNull{}}], [V.Field{"category", V.Value.nat(5n)}], [V.Field{"category", V.VStr{"*"}}], [V.Field{"imported_payee", V.VStr{"James"}}], [V.Field{"imported_payee", V.VStr{"Evy"}}], [V.Field{"imported_payee", V.VStr{"Charlotte"}}], [V.Field{"imported_payee", V.VStr{"Georgia"}}], [V.Field{"imported_payee", V.VStr{"sarah"}}], [V.Field{"payee", V.VStr{"id1"}}], [V.Field{"payee", V.VStr{"ID2"}}], [V.Field{"payee", V.VStr{"id3"}}], [], [V.Field{"notes", V.VStr{"Sarah"}}, V.Field{"category", V.VStr{"Alcohol"}}, V.Field{"imported_payee", V.VStr{"jim"}}, V.Field{"payee", V.VStr{"id9"}}], [V.Field{"notes", V.VStr{"NoId"}}], [V.Field{"notes", V.VStr{""}}], [V.Field{"notes", V.VMissing{}}], [V.Field{"account", V.VStr{"acct1"}}], [V.Field{"account", V.VStr{"ACCT"}}], [V.Field{"date", V.VStr{"2020-01-20"}}], [V.Field{"amount", V.Value.nat(100n)}]]

def keys() -> List<&2, String>:
  ["*", "f", "b", "a", "j", "james", "food", "id1", "id2", "id3", "e", "s", "g", "n", "x", ""]

def rule_at(i: Nat) -> Y.Rule:
  Result.default(&2, &2, Y.RuleError, Y.Rule, R.Rule.new(Maybe.default(&2, List<&2, V.Field>, List.get(&2, List<&2, V.Field>, pool(), i), Nil{})),
    Y.Rule{V.VMissing{}, V.VNull{}, V.VMissing{}, Nil{}, Nil{}})

def build(ops: List<&2, Nat>, +ix: I.RuleIndexer) -> I.RuleIndexer:
  match ops:
    case Nil{}:
      ix
    case Con{+op, t}:
      build(t, Bool.pick(I.RuleIndexer, Nat.is_eq(Nat.mod(op, 2n), 1n), I.RuleIndexer.index(ix, rule_at(Nat.div(op, 2n))),
        I.RuleIndexer.remove(ix, rule_at(Nat.div(op, 2n)))))

def ids(rules: List<&2, Y.Rule>) -> List<&2, String>:
  match rules:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{V.Value.to_string(R.Rule.get_id(r)), ids(t)}

def show(rules: List<&2, Y.Rule>) -> String:
  String.join(ids(rules), ",")

def asked(qs: List<&2, List<&2, V.Field>>, +ix: I.RuleIndexer) -> List<&2, String>:
  match qs:
    case Nil{}:
      Nil{}
    case Con{q, t}:
      Con{show(I.RuleIndexer.get_applicable_rules(ix, q)), asked(t, ix)}

def filed(ks: List<&2, String>, +ix: I.RuleIndexer) -> List<&2, String>:
  match ks:
    case Nil{}:
      Nil{}
    case Con{k, t}:
      Con{show(I.RuleIndexer.get_index(ix, k)), filed(t, ix)}

def key_of(vs: List<&2, V.Value>, +ix: I.RuleIndexer) -> List<&2, String>:
  match vs:
    case Nil{}:
      Nil{}
    case Con{v, t}:
      Con{Maybe.default(&2, String, I.RuleIndexer.get_key(ix, v), "null"), key_of(t, ix)}

def for_value(vs: List<&2, V.Value>, +ix: I.RuleIndexer) -> List<&2, String>:
  match vs:
    case Nil{}:
      Nil{}
    case Con{v, t}:
      Con{show(I.RuleIndexer.get_index_for_value(ix, v)), for_value(t, ix)}

def report(+ix: I.RuleIndexer) -> String:
  String.join(asked(queries(), ix), ";") ++ "|" ++ String.join(filed(keys(), ix), ";") ++ "|" ++
    String.join(key_of([V.VNull{}, V.VMissing{}, V.VStr{""}, V.VStr{"Abc"}, V.VStr{"x"}, V.Value.nat(5n), V.VStr{"\u{c9}A"}, V.Value.array([V.VStr{"a"}])], ix), ";") ++ "|" ++
    String.join(for_value([V.VNull{}, V.VStr{"Food"}, V.VStr{"james"}, V.VStr{"zzz"}, V.VStr{""}], ix), ";")

def scen(field: String, method: Maybe<&2, String>, ops: List<&2, Nat>) -> String:
  report(build(ops, I.RuleIndexer.new(field, method)))

